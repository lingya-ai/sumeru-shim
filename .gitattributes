# 统一换行符，避免 Windows 上每次都刷 CRLF 警告
# 存储与检出都用 LF；PowerShell / cmd 脚本用 CRLF（否则某些解释器会出错）
* text=auto eol=lf

*.ps1   text eol=crlf
*.psm1  text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf

# 二进制，不做换行转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.zip   binary
*.gz    binary
*.7z    binary
*.dll   binary
*.exe   binary
*.pdb   binary
*.pak   binary
