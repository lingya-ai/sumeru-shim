# Debian mirror for image builds (e.g. mirrors.aliyun.com)
# DEBIAN_MIRROR=

# Host port overrides (defaults 8080 / 6901)
# SUMERU_HTTP_PORT=8080
# SUMERU_NOVNC_PORT=6901

# Copy to .env (same directory as compose.yaml) only if you need overrides.
SUMERU_SCREEN=1280x800x24
# Chinese input: the image ships fcitx5 and the container starts it by default.
# Set to "off" to skip the IME (noVNC Chinese input then relies on the client).
SUMERU_IME=fcitx
SUMERU_KEEP_LAST_TAB=1

# --- HTTP auth (/gw + /mcp) -------------------------------------------------
# Empty = local/private use only. Set it to a long random value when the shim
# is reachable beyond localhost; both /gw and /mcp then require the token
# (Authorization: Bearer <key> or X-Sumeru-Token: <key>).
# SUMERU_API_KEY=change-me-to-a-long-random-value
# auto (default) = enforce MCP whenever a key is set; required = always enforce
# (fail fast without a key); off = leave /mcp open while /gw stays keyed.
# SUMERU_MCP_AUTH=auto
# Prefer a secret file over the env var (env shows up in `docker inspect`):
# SUMERU_API_KEY_FILE=/run/secrets/api_key

# --- VNC auth ---------------------------------------------------------------
# none (default) = no RFB password, 5900 stays loopback-only via -localhost.
# vnc = require the x11vnc RFB password below (noVNC prompts for it).
# SUMERU_VNC_AUTH=vnc
# Exactly 8 ASCII chars: RFB/DES only uses the first 8 bytes; longer values are
# rejected at startup instead of silently truncated. Missing value fails fast.
# SUMERU_VNC_PASSWORD=changeme
# Prefer a secret file over the env var:
# SUMERU_VNC_PASSWORD_FILE=/run/secrets/vnc_password
# 0 = allow non-loopback 5900 connections (only with SUMERU_VNC_AUTH=vnc).
# SUMERU_VNC_LOCALHOST=1
