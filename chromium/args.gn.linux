# 须弥内核 gn 参数（Linux 版，Docker 构建用）
# 与 Windows 版（args.gn）同构：release、静态、无 nacl、x64。

is_debug = false
is_component_build = false
is_official_build = true

target_cpu = "x64"
target_os = "linux"

enable_nacl = false

# 符号：正式包 level=1（保留函数名，便于崩溃分析）
symbol_level = 1
blink_symbol_level = 0
v8_symbol_level = 0

# 构建内存/时长取舍：关掉 thin LTO、CFI 与 PGO
use_thin_lto = false
is_cfi = false
chrome_pgo_phase = 0

# 品牌化资源（sumeru overlay 会改写这些常量）
is_chrome_branded = false

# 专有编解码：启用 H.264/AAC/MP3（主流 mp4 / HLS 播放必需）。
# 注意：ffmpeg_branding="Chrome" 只是编解码品牌，不影响 chrome 品牌化资源
# （is_chrome_branded 仍为 false）。
proprietary_codecs = true
ffmpeg_branding = "Chrome"

# 生成完整的 Chromium 第三方许可证文件（LICENSES.chromium.html），
# 二进制分发合规所需；构建后应出现在 out/release-linux/。
generate_about_credits = true

# Linux 专用：走 gclient 自带 sysroot + clang（默认）
use_sysroot = true
is_clang = true

# 容器内无桌面：保留 dbus（remoting 依赖），关掉 gnome keyring
use_dbus = true
use_gnome_keyring = false
use_glib = true
