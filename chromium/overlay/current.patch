+void SumeruGateway::HandleDispatchMouse(const base::DictValue& params,
+                                         double req_id) {
+  const std::string* target_id = params.FindString("targetId");
+  const std::string* type = params.FindString("type");
+  if (!target_id || target_id->empty() || !type) {
+    base::DictValue resp;
+    resp.Set("type", "response");
+    resp.Set("id", req_id);
+    resp.Set("ok", false);
+    base::DictValue e;
+    e.Set("code", "GW_INVALID_ARGUMENT");
+    e.Set("message", "targetId and type required");
+    resp.Set("error", std::move(e));
+    Send(base::Value(std::move(resp)));
+    return;
+  }
+  const std::string tid = *target_id;
+  const std::string mouse_type = *type;
+  const int mx = params.FindInt("x").value_or(0);
+  const int my = params.FindInt("y").value_or(0);
+  const std::string button = params.FindString("button")
+                                 ? *params.FindString("button")
+                                 : (mouse_type == "mouseMoved" ? "none" : "left");
+  const int clicks = params.FindInt("clickCount").value_or(mouse_type == "mouseMoved" ? 0 : 1);
+  const int dx = params.FindInt("deltaX").value_or(0);
+  const int dy = params.FindInt("deltaY").value_or(0);
+  content::BrowserThread::GetTaskRunnerForThread(content::BrowserThread::UI)
+      ->PostTask(
+          FROM_HERE,
+          base::BindOnce(
+              [](SumeruGateway* self, double req_id, const std::string& t_id,
+                 const std::string& mouse_type, int mx, int my,
+                 const std::string& button, int clicks, int dx, int dy) {
+                auto send_resp = [&](bool ok, const std::string& code_e,
+                                     const std::string& message,
+                                     const std::string& dispatched) {
+                  base::DictValue resp;
+                  resp.Set("type", "response");
+                  resp.Set("id", req_id);
+                  resp.Set("ok", ok);
+                  if (ok) {
+                    base::DictValue r;
+                    r.Set("dispatched", dispatched);
+                    resp.Set("result", std::move(r));
+                  } else {
+                    base::DictValue e;
+                    e.Set("code", code_e);
+                    e.Set("message", message);
+                    resp.Set("error", std::move(e));
+                  }
+                  content::BrowserThread::GetTaskRunnerForThread(
+                      content::BrowserThread::IO)
+                      ->PostTask(FROM_HERE,
+                                 base::BindOnce(
+                                     [](SumeruGateway* self,
+                                        base::Value msg) {
+                                       self->Send(std::move(msg));
+                                     },
+                                     self, base::Value(std::move(resp))));
+                };
+                content::WebContents* matched = ResolveTargetContents(t_id);
+                if (!matched) {
+                  send_resp(false, "SUMERU_TARGET_NOT_FOUND",
+                            "no web contents for target", "");
+                  return;
+                }
+                auto* rwhv = matched->GetRenderWidgetHostView();
+                if (!rwhv || !rwhv->GetRenderWidgetHost()) {
+                  send_resp(false, "SUMERU_TARGET_NOT_READY",
+                            "no render widget host view", "");
+                  return;
+                }
+                auto* widget_host = rwhv->GetRenderWidgetHost();
+                blink::WebMouseEvent event;
+                if (mouse_type == "mousePressed") {
+                  event.SetType(blink::WebInputEvent::Type::kMouseDown);
+                } else if (mouse_type == "mouseReleased") {
+                  event.SetType(blink::WebInputEvent::Type::kMouseUp);
+                } else {
+                  event.SetType(blink::WebInputEvent::Type::kMouseMove);
+                }
+                event.SetPositionInWidget(gfx::PointF(mx, my));
+                event.SetPositionInScreen(gfx::PointF(mx, my));
+                event.click_count = clicks;
+                if (button == "right") {
+                  event.button = blink::WebMouseEvent::Button::kRight;
+                } else if (button == "middle") {
+                  event.button = blink::WebMouseEvent::Button::kMiddle;
+                } else {
+                  event.button = blink::WebMouseEvent::Button::kLeft;
+                }
+                widget_host->ForwardMouseEvent(event);
+                send_resp(true, "", "", mouse_type);
+              },
+              this, req_id, tid, mouse_type, mx, my, button, clicks, dx, dy));
+}
