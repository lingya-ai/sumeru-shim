+#include "ui/accessibility/ax_tree.h"
+
+namespace content::sumeru {
+
+namespace {
+
+// Role identity is taken from `ax::mojom::ToString(role)` (lowercased) rather
+// than the C++ enumerator: sumeru's vocabulary tracks Chromium role renames
+// (e.g. ComboBox -> ComboBoxSelect) and the string form is stable across them.
+std::string RawRole(ax::mojom::Role role) {
+  return base::ToLowerASCII(std::string_view(ui::ToString(role)));
+}
+
+// Dropped entirely: InlineTextBox text already appears via its StaticText.
+bool ShouldSkipRole(ax::mojom::Role role) {
+  return RawRole(role) == "inlinetextbox";
+}
+
+// Unnamed wrappers are hoisted (children render at the wrapper's depth).
+bool IsBareContainerRole(ax::mojom::Role role) {
+  const std::string raw = RawRole(role);
+  return raw == "genericcontainer" || raw == "none" || raw == "ignored" ||
+         raw == "unknown";
+}
+
+// Roles that receive a ref (interactive or locatable). Mirrors the shim's
+// REF_ROLES table so both implementations stay aligned.
+bool ShouldAssignRef(ax::mojom::Role role) {
+ // sumeru: 用 constexpr std::array<std::string_view> 而不是
+ // static const base::flat_set<std::string> —— 后者带 exit-time destructor，
+ // 在本项目的 -Werror,-Wexit-time-destructors 下无法编译。
+  static constexpr std::string_view kRefRoles[] = {
+      "button",       "link",          "checkbox",   "radiobutton",
+      "textfield",    "searchbox",     "combobox",   "comboboxselect",
+      "listbox",      "listboxoption", "slider",     "spinbutton",
+      "switch",       "menuitem",      "menuitemcheckbox", "menuitemradio",
+      "tab",          "treeitem",      "iframe",
+  };
+  const std::string raw = RawRole(role);
+  for (std::string_view candidate : kRefRoles) {
+    if (candidate == raw) {
+      return true;
+    }
+  }
+  return false;
+}
+
+// Kernel-side role spelling (sumeru vocabulary).
+std::string RoleName(ax::mojom::Role role) {
+  const std::string raw = RawRole(role);
+ // 同上：constexpr 数组避免 exit-time destructor。
+  struct Alias {
+    std::string_view raw;
+    std::string_view name;
+  };
+  static constexpr Alias kAliases[] = {
+      {"rootwebarea", "root"},        {"statictext", "text"},
+      {"link", "anchor"},             {"inlinetextbox", "text"},
+      {"textfield", "textbox"},       {"comboboxselect", "combobox"},
+      {"radiobutton", "radio"},       {"unorderedlist", "unordered_list"},
+      {"orderedlist", "ordered_list"},{"listitem", "list_item"},
+      {"tablerow", "table_row"},      {"cell", "table_cell"},
+  };
+  for (const Alias& alias : kAliases) {
+    if (alias.raw == raw) {
+      return std::string(alias.name);
+    }
+  }
+  return raw;
+}
+
+// `text` rows are the only ones carrying a quoted name.
+std::string RowLabel(ax::mojom::Role role,
+                     const std::u16string& name,
+                     const std::string& role_name) {
+  if (RawRole(role) != "statictext" || name.empty()) {
+    return role_name;
+  }
+  std::string escaped = base::UTF16ToUTF8(name);
+  base::ReplaceChars(escaped, "\\", "\\\\", &escaped);
+  base::ReplaceChars(escaped, "\"", "\\\"", &escaped);
+  base::ReplaceChars(escaped, "\n", "\\n", &escaped);
+  base::ReplaceChars(escaped, "\t", "\\t", &escaped);
+  return base::StringPrintf("%s \"%s\"", role_name.c_str(), escaped.c_str());
+}
+
+// `css:<tag>[name="…"]` (name > id), mirroring the shim's cssLocatorFor().
+std::string BuildCssLocator(const ui::AXNode& node) {
+  const std::string html_tag =
+      node.data().GetStringAttribute(ax::mojom::StringAttribute::kHtmlTag);
+  if (html_tag.empty()) {
+    return std::string();
+  }
+  const std::string name =
+      node.data().GetStringAttribute(ax::mojom::StringAttribute::kName);
+  if (!name.empty()) {
+    return base::StringPrintf("css:%s[name=\"%s\"]", html_tag.c_str(),
+                              name.c_str());
+  }
+  const std::string html_id =
+      node.data().GetStringAttribute(ax::mojom::StringAttribute::kHtmlId);
+  if (!html_id.empty()) {
+    return base::StringPrintf("css:#%s", html_id.c_str());
+  }
+  return std::string();
+}
+
+// `href:` locator only when the URL is absolute (relative links get no loc).
+std::string BuildHrefLocator(const ui::AXNode& node) {
+  const std::string url =
+      node.data().GetStringAttribute(ax::mojom::StringAttribute::kUrl);
+  if (url.empty() || url.find("://") == std::string::npos) {
+    return std::string();
+  }
+  return "href:" + url;
+}
+
+}  // namespace
+
+// static
+SnapshotSerializer::Result SnapshotSerializer::Serialize(
+    const ui::AXTree& tree,
+    const Options& options) {
+  Result result;
+  int32_t next_ref = 1;
+
+  const ui::AXNode* root =
+      options.root_id == ui::kInvalidAXNodeID ? tree.root()
+                                              : tree.GetFromId(options.root_id);
+  if (!root) {
+    result.content = "root";
+    return result;
+  }
+
+ // `depth` is the visual depth (bare wrappers do not consume a level).
+  std::function<void(const ui::AXNode&, int)> render =
+      [&](const ui::AXNode& node, int depth) {
+        const ax::mojom::Role role = node.data().role;
+        LOG(ERROR) << "[SUMERU-RENDER] role=" << RawRole(role)
+                   << " skip=" << ShouldSkipRole(role)
+                   << " children=" << node.children().size();
+        if (ShouldSkipRole(role)) {
+          return;
+        }
+
+        const std::u16string name =
+            node.data().GetString16Attribute(ax::mojom::StringAttribute::kName);
+        const bool bare = IsBareContainerRole(role) && name.empty();
+        if (bare) {
+          for (const ui::AXNode* child : node.children()) {
+            if (child) {
+              render(*child, depth);
+            }
+          }
+          return;
+        }
+
+        const std::string role_name = RoleName(role);
+        std::string line(static_cast<size_t>(depth) * 2, ' ');
+        line.append(RowLabel(role, name, role_name));
+
+        if (ShouldAssignRef(role)) {
+          const int32_t ref_id = next_ref++;
+          std::string suffix;
+          std::string loc;
+          if (options.include_stable_locator) {
+            loc = BuildHrefLocator(node);
+            if (loc.empty()) {
+              loc = BuildCssLocator(node);
+            }
+            if (!loc.empty()) {
+              suffix.append(", loc=").append(loc);
+            }
+          }
+          NodeRef ref;
+          ref.ref_id = ref_id;
+          // Kernel ref triple is (frame_id, backend_node_id, document_id); the
+          // AX node id is the in-tree identity, callers fill frame/document.
+          ref.backend_node_id = static_cast<int32_t>(node.data().id);
+          ref.role = role_name;
+          ref.name = base::UTF16ToUTF8(name);
+          ref.loc = loc;
+          // `unstable` marks a ref whose locator may stop resolving without the
+          // document changing identity — in the kernel it comes from Blink's
+          // dirty/layout state for the backing node.
+          //
+          // Nothing on this layer can answer that today: ui::AXNodeData exposes
+          // IsIgnored()/IsInvisibleOrIgnored() (platform visibility) and
+          // GetRestriction() (readOnly/disabled), neither of which means
+          // "locator may drift". Wiring it properly needs a Blink-side dirty
+          // bit plumbed through the accessibility tree, so the field stays
+          // false rather than guessing a semantic.
+          ref.unstable = false;
+          result.refs.push_back(std::move(ref));
+
+          line.append(" [ref=").append(base::NumberToString(ref_id));
+          line.append(suffix);
+          line.append("]");
+        }
+
+        result.content.append(line).append("\n");
+
+        for (const ui::AXNode* child : node.children()) {
+          if (child) {
+            render(*child, depth + 1);
+          }
+        }
+      };
+
+  render(*root, 0);
+
+  while (!result.content.empty() && result.content.back() == '\n') {
+    result.content.pop_back();
+  }
+  return result;
+}
+
+}  // namespace content::sumeru
