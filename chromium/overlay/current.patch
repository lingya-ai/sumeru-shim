+// Copyright 2026 The Sumeru Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_SUMERU_TABS_SUMERU_LAST_TAB_GUARD_H_
+#define CHROME_BROWSER_SUMERU_TABS_SUMERU_LAST_TAB_GUARD_H_
+
+namespace sumeru {
+
+// The product is a single-window browser: if the last tab could be closed, the
+// window (and with it the whole browser process) would go away. Keeping one tab
+// alive makes "the browser never exits because a tab was closed" a structural
+// property instead of a convention.
+//
+// Enabled unless SUMERU_KEEP_LAST_TAB=0 (the switch itself lives in
+// `sumeru/browser/tabs/tab_ops.h` so content code can share the same policy).
+//
+// True when a close that would empty a `tab_count`-tab strip must be refused.
+// Quit paths pass through: SIGTERM -> AttemptExit -> IsTryingToQuit(), so the
+// container still stops gracefully and flushes the profile.
+bool ShouldBlockLastTabClose(int tab_count);
+
+}  // namespace sumeru
+
+#endif  // CHROME_BROWSER_SUMERU_TABS_SUMERU_LAST_TAB_GUARD_H_
