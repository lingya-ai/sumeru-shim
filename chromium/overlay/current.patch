+
+#include "base/no_destructor.h"
+
+namespace content::sumeru {
+
+namespace {
+
+TabOpsDelegate** DelegateSlot() {
+  static TabOpsDelegate* delegate = nullptr;
+  return &delegate;
+}
+
+}  // namespace
+
+void SetTabOpsDelegate(TabOpsDelegate* delegate) {
+  *DelegateSlot() = delegate;
+}
+
+TabOpsDelegate* GetTabOpsDelegate() {
+  return *DelegateSlot();
+}
+
+bool IsKeepLastTabEnabled() {
+  static const bool enabled = [] {
+    const char* value = std::getenv("SUMERU_KEEP_LAST_TAB");
+    return value == nullptr || std::string(value) != "0";
+  }();
+  return enabled;
+}
