+// Copyright 2026 The Sumeru Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CONTENT_BROWSER_SUMERU_SNAPSHOT_SERIALIZER_H_
+#define CONTENT_BROWSER_SUMERU_SNAPSHOT_SERIALIZER_H_
+
+#include <string>
+#include <vector>
+
+#include "base/types/optional_ref.h"
+#include <cstdint>
+#include "ui/accessibility/ax_node_id_forward.h"
+
+namespace ui {
+class AXNode;
+class AXTree;
+}  // namespace ui
+
+namespace content::sumeru {
+
+// Native snapshot serializer: walks the accessibility tree in-process and
+// renders the kernel-shaped text snapshot plus the ref table.
+//
+// Behaviour is pinned to the expected snapshot format (see
+// local snapshot fixtures.
+// sumeru-shim/chromium/evidence/):
+//
+// root
+// heading
+// text "Hello"
+// textbox [ref=1, loc=css:input[name="q"]]
+// anchor [ref=2, loc=href:https://example.com/a, url=https://example.com/a]
+// text "Ex"
+// iframe [ref=3]
+// root
+// button [ref=4]
+// text "Inner"
+//
+// Rules enforced here:
+// * `root` never gets a ref; only interactive/locatable roles do;
+// * only `text` rows carry a quoted name;
+// * unnamed wrappers (generic/none/container) are hoisted away;
+// * InlineTextBox is dropped (its text already appears via StaticText);
+// * loc is `css:<selector>` or `href:<original href>`; url is absolute;
+// * nodes flagged unstable omit their loc.
+// Stable reference to a node (mirrors the kernel contract).
+struct NodeRef {
+  int32_t ref_id = 0;
+  int32_t backend_node_id = 0;
+  std::string frame_id;
+  std::string document_id;
+  std::string role;
+  std::string name;
+  std::string loc;
+  std::string url;
+  bool unstable = false;
+};
+
+class SnapshotSerializer {
+ public:
+  struct Options {
+    // Only serialize the subtree rooted at this node (kSubtree scope).
+    ui::AXNodeID root_id = ui::kInvalidAXNodeID;
+    bool include_stable_locator = true;
+  };
+
+  struct Result {
+    std::string content;
+    std::vector<NodeRef> refs;
+  };
+
+  SnapshotSerializer() = delete;
+
+ // Serializes `tree` starting at `options.root_id` (or the tree root).
+  static Result Serialize(const ui::AXTree& tree, const Options& options);
+};
+
+}  // namespace content::sumeru
+
+#endif  // CONTENT_BROWSER_SUMERU_SNAPSHOT_SERIALIZER_H_
