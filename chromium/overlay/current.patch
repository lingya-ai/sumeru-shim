+// Copyright 2026 The Sumeru Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef SUMERU_BROWSER_GATEWAY_SUMERU_GATEWAY_H_
+#define SUMERU_BROWSER_GATEWAY_SUMERU_GATEWAY_H_
+
+#include <memory>
+#include <string>
+
+#include <deque>
+#include <map>
+#include <set>
+#include <utility>
+
+#include "base/memory/weak_ptr.h"
+#include "base/values.h"
+#include "content/public/browser/devtools_agent_host.h"
+#include "content/public/browser/devtools_agent_host_client.h"
+#include "net/base/io_buffer.h"
+#include "net/socket/stream_socket.h"
+#include "net/socket/unix_domain_server_socket_posix.h"
+
+namespace content::sumeru {
+
+// K-Gateway (gateway): the browser process's single external control
+// channel ? a private UDS serving a versioned JSON-line protocol (host-IPC
+// v2 shape). Wire protocol and gateway methods: see sumeru_gateway.cc.
+class SumeruGateway : public content::DevToolsAgentHostClient {
+ public:
+  static void Start();
+
+ private:
+  friend void StartGateway(content::BrowserContext* browser_context);
+  SumeruGateway();
+  ~SumeruGateway() override;
+  SumeruGateway(const SumeruGateway&) = delete;
+  SumeruGateway& operator=(const SumeruGateway&) = delete;
+
+  void DoAcceptLoop();
+  void OnAccepted(int rv);
+  void StartRead();
+  void OnRead(int rv);
+  void HandleLine(const std::string& line);
+  void HandleHello(const base::Value& msg);
+  void HandleRequest(const base::Value& msg);
+  void Send(const base::Value& msg);
+  void BroadcastEvent(const std::string& event,
+                       base::DictValue payload);
+  void CloseConnection();
+
+  std::unique_ptr<net::UnixDomainServerSocket> server_;
+  std::unique_ptr<net::StreamSocket> client_;
+  std::unique_ptr<net::StreamSocket> pending_client_;
+  std::string token_;
+  std::string server_session_;
+  std::string read_buffer_;
+  scoped_refptr<net::IOBufferWithSize> read_io_buffer_;
+  bool authenticated_ = false;
+  bool subscribed_ = false;
+  int last_seq_sent_ = 0;
+  int revision() const { return revision_; }
+  int revision_ = 0;
+
+ public:
+  void set_browser_context(content::BrowserContext* ctx) {
+    browser_context_ = ctx;
+  }
+
+ private:
+  raw_ptr<content::BrowserContext> browser_context_ = nullptr;
+
+ // evaluate: DevTools-agent-backed evaluation (browser-internal path —
+ // no external CDP pipe; stealth-clean since no domain enablement on the page
+ // beyond the evaluate itself).
+  void HandleImeCompose(const base::DictValue& params, double req_id);
+  void HandleDispatchKey(const base::DictValue& params, double req_id);
+  void HandleDispatchMouse(const base::DictValue& params, double req_id);
+  void HandleSnapshotAX(const base::DictValue& params, double req_id);
+  void HandleEvaluate(const base::DictValue& params, double req_id);
+  void HandleNavigate(const base::DictValue& params, double req_id);
+ // F22 helpers: state methods run on the UI thread and post their
+ // response/event back to the IO thread (where the socket lives).
+  void PostFailure(int sid_v, int req_id, const std::string& code,
+                   const std::string& message);
+  void PostResultAndEvent(int sid_v, int req_id, const std::string& event,
+                          base::DictValue event_payload);
+  void FailPendingEval(int eid, const std::string& code,
+                       const std::string& message);
+  void FailAllPending();
+  void HandleAgentReply(const std::string& text);
+  void ResolveCommittedNavs();
+  void DispatchProtocolMessage(content::DevToolsAgentHost* agent_host,
+                               base::span<const uint8_t> message) override;
+  void AgentHostClosed(content::DevToolsAgentHost* agent_host) override;
+  scoped_refptr<content::DevToolsAgentHost> eval_agent_;
+  int eval_next_id_ = 1;
+  struct PendingEval {
+    int id;
+    double req_id;
+    std::string target_id;
+  };
+  std::map<int, PendingEval> eval_pending_;
+ // navigate fix: navigate completion bookkeeping.
+  std::set<int> nav_awaiting_commit_;
+  std::set<int> nav_awaiting_load_;
+  std::string eval_frame_key_;
+  base::WeakPtrFactory<SumeruGateway> weak_factory_{this};
+};
+
+}  // namespace content::sumeru
+
+#endif  // SUMERU_BROWSER_GATEWAY_SUMERU_GATEWAY_H_
