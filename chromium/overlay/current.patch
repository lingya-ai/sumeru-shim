@@ -0,0 +1,169 @@
+// Copyright 2026 The Sumeru Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/sumeru/tabs/sumeru_tab_ops.h"
+
+#include <string>
+#include <vector>
+
+#include "base/no_destructor.h"
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/browser/ui/browser_tabstrip.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/browser_window/public/global_browser_collection.h"
+#include "chrome/browser/ui/tabs/tab_enums.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "content/public/browser/devtools_agent_host.h"
+#include "content/public/browser/web_contents.h"
+#include "sumeru/browser/tabs/tab_ops.h"
+#include "url/gurl.h"
+
+namespace sumeru {
+namespace {
+
+// DevTools target ids are "<type>:<uuid>" and are the ids the gateway speaks;
+// deriving them here keeps agent ids identical to CDP ids (as TabRegistry did).
+std::string TargetIdFor(content::WebContents* contents) {
+  if (!contents) {
+    return std::string();
+  }
+  auto agent_host = content::DevToolsAgentHost::GetOrCreateFor(contents);
+  return agent_host ? agent_host->GetId() : std::string();
+}
+
+BrowserWindowInterface* ActiveBrowser() {
+  GlobalBrowserCollection* collection = GlobalBrowserCollection::GetInstance();
+  return collection ? collection->GetLastActiveBrowser() : nullptr;
+}
+
+class SumeruTabOps : public content::sumeru::TabOpsDelegate {
+ public:
+  std::string CreateTab(const GURL& url) override {
+    BrowserWindowInterface* browser = ActiveBrowser();
+    if (!browser) {
+      return std::string();
+    }
+    TabStripModel* tabs = browser->GetTabStripModel();
+    if (!tabs) {
+      return std::string();
+    }
+    content::WebContents* contents = chrome::AddAndReturnTabAt(
+        browser, url.is_empty() ? GURL("about:blank") : url, tabs->count(),
+        /*foreground=*/false);
+    return TargetIdFor(contents);
+  }
+
+  bool CloseTab(const std::string& target_id) override {
+    BrowserWindowInterface* browser = ActiveBrowser();
+    if (!browser) {
+      return false;
+    }
+    TabStripModel* tabs = browser->GetTabStripModel();
+    if (!tabs) {
+      return false;
+    }
+    const int index = IndexOf(tabs, target_id);
+    if (index < 0) {
+      return false;
+    }
+    tabs->CloseWebContentsAt(index, CLOSE_USER_GESTURE);
+    return true;
+  }
+
+  bool ActivateTab(const std::string& target_id) override {
+    BrowserWindowInterface* browser = ActiveBrowser();
+    if (!browser) {
+      return false;
+    }
+    TabStripModel* tabs = browser->GetTabStripModel();
+    if (!tabs) {
+      return false;
+    }
+    const int index = IndexOf(tabs, target_id);
+    if (index < 0) {
+      return false;
+    }
+    tabs->ActivateTabAt(index);
+    return true;
+  }
+
+  std::vector<content::sumeru::TabSnapshot> ListTabs() override {
+    std::vector<content::sumeru::TabSnapshot> out;
+    BrowserWindowInterface* browser = ActiveBrowser();
+    if (!browser) {
+      return out;
+    }
+    TabStripModel* tabs = browser->GetTabStripModel();
+    if (!tabs) {
+      return out;
+    }
+    const int active = tabs->active_index();
+    for (int i = 0; i < tabs->count(); ++i) {
+      content::WebContents* contents = tabs->GetWebContentsAt(i);
+      if (!contents) {
+        continue;
+      }
+      content::sumeru::TabSnapshot entry;
+      entry.target_id = TargetIdFor(contents);
+      entry.url = contents->GetLastCommittedURL().spec();
+      entry.title = base::UTF16ToUTF8(contents->GetTitle());
+      entry.active = (i == active);
+      out.push_back(std::move(entry));
+    }
+    return out;
+  }
+
+  int TabCount() override {
+    BrowserWindowInterface* browser = ActiveBrowser();
+    if (!browser) {
+      return 0;
+    }
+    TabStripModel* tabs = browser->GetTabStripModel();
+    return tabs ? tabs->count() : 0;
+  }
+
+  std::string GetActiveTargetId() override {
+    BrowserWindowInterface* browser = ActiveBrowser();
+    if (!browser) {
+      return std::string();
+    }
+    TabStripModel* tabs = browser->GetTabStripModel();
+    if (!tabs) {
+      return std::string();
+    }
+    return TargetIdFor(tabs->GetActiveWebContents());
+  }
+
+  content::WebContents* GetWebContents(const std::string& target_id) override {
+    BrowserWindowInterface* browser = ActiveBrowser();
+    if (!browser) {
+      return nullptr;
+    }
+    TabStripModel* tabs = browser->GetTabStripModel();
+    if (!tabs) {
+      return nullptr;
+    }
+    const int index = IndexOf(tabs, target_id);
+    return index < 0 ? nullptr : tabs->GetWebContentsAt(index);
+  }
+
+ private:
+  static int IndexOf(TabStripModel* tabs, const std::string& target_id) {
+    for (int i = 0; i < tabs->count(); ++i) {
+      if (TargetIdFor(tabs->GetWebContentsAt(i)) == target_id) {
+        return i;
+      }
+    }
+    return -1;
+  }
+};
+
+}  // namespace
+
+void InstallSumeruTabOps() {
+  static base::NoDestructor<SumeruTabOps> tab_ops;
+  content::sumeru::SetTabOpsDelegate(tab_ops.get());
+}
+
+}  // namespace sumeru
