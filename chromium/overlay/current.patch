@@ -0,0 +1,68 @@
+// Copyright 2026 The Sumeru Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CONTENT_BROWSER_SUMERU_TAB_REGISTRY_H_
+#define CONTENT_BROWSER_SUMERU_TAB_REGISTRY_H_
+
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "base/memory/raw_ptr.h"
+#include "url/gurl.h"
+
+namespace content {
+class WebContents;
+}  // namespace content
+
+namespace content::sumeru {
+
+// sumeru: content 层自己的 tab 注册表。
+//
+// 为什么需要它：`content` 层没有「枚举所有 WebContents」的公开 API
+// （`chrome::FindBrowserWithTab` / `TabStripModel` 都在 chrome 层，
+// content 不能反向依赖 chrome —— 这是 Chromium 的分层规则）。
+//
+// 而 `NodeClient.ListTabs` 需要枚举本 agent 创建的 tab。因此这里维护一个
+// 进程内注册表：Create 时登记、Close 时注销。存活对象由本注册表持有，
+// 避免 `WebContents::Create` 返回的 unique_ptr 立刻析构。
+//
+// 语义边界（与 sumeru 对齐）：
+// * 只登记**经 sumeru NodeClient 创建**的 tab，不覆盖用户手动打开的 tab；
+// * 这与 sumeru 的 `createTab()` 返回的 target_id 语义一致——agent 只关心
+// 自己创建的 target。
+class TabRegistry {
+ public:
+ // 登记一个由 CreateTab 创建并已导航的 WebContents，返回它的 target id。
+ // 注册表接管所有权。
+  static std::string Register(std::unique_ptr<content::WebContents> contents);
+
+ // 列出所有已登记的 tab。字段与 sumeru 的 `task.tabs()` 对齐
+ // （{label, targetId, title, active, openedBy}）：
+ // * label —— SDK 层分配的页面标签（p1、p2…），内核侧为空
+ // * title —— 页面标题（sumeru 返回 title 而不是 url）
+ // * opened_by —— 谁打开的标签页：agent | user（本注册表只登记 agent 创建的 tab）
+ // * url —— 我们额外保留的字段（sumeru 不返回，内核需要它做导航判断）
+  struct Entry {
+    std::string target_id;
+    std::string url;
+    bool active = false;
+    std::string label;
+    std::string title;
+    std::string opened_by;
+  };
+  static std::vector<Entry> List();
+
+ // 按 target id 关闭并注销。返回是否找到。
+  static bool Close(const std::string& target_id);
+
+ // 把某个 target 标记为 active（其余置 false）。
+  static void SetActive(const std::string& target_id);
+
+  TabRegistry() = delete;
+};
+
+}  // namespace content::sumeru
+
+#endif  // CONTENT_BROWSER_SUMERU_TAB_REGISTRY_H_
