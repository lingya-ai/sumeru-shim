+
+void SumeruGateway::HandleSnapshotAX(const base::DictValue& params,
+                                      double req_id) {
+  const std::string* target_id = params.FindString("targetId");
+  if (!target_id || target_id->empty()) {
+    base::DictValue resp;
+    resp.Set("type", "response");
+    resp.Set("id", req_id);
+    resp.Set("ok", false);
+    base::DictValue e;
+    e.Set("code", "GW_INVALID_ARGUMENT");
+    e.Set("message", "targetId required");
+    resp.Set("error", std::move(e));
+    Send(base::Value(std::move(resp)));
+    return;
+  }
+  const std::string tid = *target_id;
+  const bool with_locator = params.FindBool("includeStableLocator").value_or(true);
+  content::BrowserThread::GetTaskRunnerForThread(content::BrowserThread::UI)
+      ->PostTask(
+          FROM_HERE,
+          base::BindOnce(
+              [](SumeruGateway* self, double req_id, const std::string& t_id,
+                 bool with_locator) {
+                auto send_resp = [&](bool ok, const std::string& code,
+                                     const std::string& message,
+                                     const std::string& content) {
+                  base::DictValue resp;
+                  resp.Set("type", "response");
+                  resp.Set("id", req_id);
+                  resp.Set("ok", ok);
+                  if (ok) {
+                    base::DictValue r;
+                    r.Set("content", content);
+                    resp.Set("result", std::move(r));
+                  } else {
+                    base::DictValue e;
+                    e.Set("code", code);
+                    e.Set("message", message);
+                    resp.Set("error", std::move(e));
+                  }
+                  content::BrowserThread::GetTaskRunnerForThread(
+                      content::BrowserThread::IO)
+                      ->PostTask(FROM_HERE,
+                                 base::BindOnce(
+                                     [](SumeruGateway* self,
+                                        base::Value msg) {
+                                       self->Send(std::move(msg));
+                                     },
+                                     self, base::Value(std::move(resp))));
+                };
+                // K3 gap #5: the AX-tree snapshot via
+                // RequestAXTreeSnapshot + SnapshotSerializer (the
+                // ControllerImpl::Snapshot pattern, target-resolved).
+                content::WebContents* matched = ResolveTargetContents(t_id);
+                if (!matched || !matched->GetPrimaryMainFrame()) {
+                  send_resp(false, "SUMERU_TASK_SPACE_NOT_FOUND",
+                            "no target: " + t_id, "");
+                  return;
+                }
+                auto* rfh_impl = static_cast<content::RenderFrameHostImpl*>(
+                    matched->GetPrimaryMainFrame());
+                content::sumeru::SnapshotSerializer::Options opts;
+                opts.include_stable_locator = with_locator;
+                const std::string doc_url =
+                    rfh_impl->GetLastCommittedURL().spec();
+                auto ax_params =
+                    ::content::mojom::SnapshotAccessibilityTreeParams::New();
+                rfh_impl->RequestAXTreeSnapshot(
+                    base::BindOnce(
+                        [](SumeruGateway* self, double req_id,
+                           content::sumeru::SnapshotSerializer::Options opts,
+                           std::string doc_url,
+                           ui::AXTreeUpdate& update) {
+                          auto tree = std::make_unique<ui::AXTree>();
+                          tree->Unserialize(update);
+                          auto serialized =
+                              content::sumeru::SnapshotSerializer::Serialize(
+                                  *tree, opts);
+                          base::DictValue r;
+                          r.Set("content", serialized.content);
+                          base::ListValue refs;
+                          for (const auto& ref : serialized.refs) {
+                            base::DictValue rd;
+                            rd.Set("role", ref.role);
+                            rd.Set("name", ref.name);
+                            rd.Set("url", doc_url);
+                            if (!ref.loc.empty()) {
+                              rd.Set("loc", ref.loc);
+                            }
+                            refs.Append(base::Value(std::move(rd)));
+                          }
+                          r.Set("refs", std::move(refs));
+                          base::DictValue resp;
+                          resp.Set("type", "response");
+                          resp.Set("id", req_id);
+                          resp.Set("ok", true);
+                          resp.Set("result", std::move(r));
+                          content::BrowserThread::GetTaskRunnerForThread(
+                              content::BrowserThread::IO)
+                              ->PostTask(
+                                  FROM_HERE,
+                                  base::BindOnce(
+                                      [](SumeruGateway* self,
+                                         base::Value msg) {
+                                        self->Send(std::move(msg));
+                                      },
+                                      self,
+                                      base::Value(std::move(resp))));
+                        },
+                        self, req_id, opts, doc_url),
+                    std::move(ax_params));
+              },
+              this, req_id, tid, with_locator));
+}
+
+
+void SumeruGateway::HandleEvaluate(const base::DictValue& params,
+                                    double req_id) {
+  const std::string* target_id = params.FindString("targetId");
+  const std::string* expression = params.FindString("expression");
+  auto fail = [&](const std::string& code, const std::string& message) {
+    base::DictValue resp;
+    resp.Set("type", "response");
+    resp.Set("id", req_id);
+    resp.Set("ok", false);
+    base::DictValue e;
+    e.Set("code", code);
+    e.Set("message", message);
+    resp.Set("error", std::move(e));
+    Send(base::Value(std::move(resp)));
+  };
+  if (!target_id || target_id->empty() || !expression) {
+    fail("GW_INVALID_ARGUMENT", "targetId and expression required");
+    return;
+  }
+  const std::string tid = *target_id;
+  const std::string expr = *expression;
+  int eid = eval_next_id_++;
+  eval_pending_[eid] = {eid, req_id, tid};
+  content::BrowserThread::GetTaskRunnerForThread(content::BrowserThread::UI)
+      ->PostTask(
+          FROM_HERE,
+          base::BindOnce(
+              [](SumeruGateway* self, int e_id, const std::string& t_id,
+                 const std::string& code_expr) {
+                // RFH::ExecuteJavaScript CHECKs
+                // CanExecuteJavaScript() — true only for WebUI/devtools/
+                // about:blank — and FATAL-crashed the whole browser on http
+                // pages (probe evidence, twice). The DevTools-agent path is
+                // the legal evaluate route for arbitrary pages; the cached
+                // attach is stable at diagnostic volume.
+                if (!self->eval_agent_ ||
+                    self->eval_agent_->GetId() != t_id) {
+                  if (self->eval_agent_) {
+                    self->eval_agent_->DetachClient(self);
+                  }
+                  self->eval_agent_ =
+                      content::DevToolsAgentHost::GetForId(t_id);
+                  if (!self->eval_agent_) {
+                    // Gateway: real tabs may only be reachable through
+                    // the embedder delegate.
+                    if (content::WebContents* eval_contents =
+                            ResolveTargetContents(t_id)) {
+                      self->eval_agent_ =
+                          content::DevToolsAgentHost::GetOrCreateFor(
+                              eval_contents);
+                    }
+                  }
+                  if (!self->eval_agent_) {
+                    self->FailPendingEval(
+                        e_id, "SUMERU_TASK_SPACE_NOT_FOUND",
+                        "no target: " + t_id);
+                    return;
+                  }
+                  if (!self->eval_agent_->AttachClient(self)) {
+                    self->eval_agent_ = nullptr;
+                    self->FailPendingEval(
+                        e_id, "SUMERU_OPERATION_FAILED", "attach failed");
+                    return;
+                  }
+                }
+                // fix (2026-11-19): no-session dispatch — see
+                // HandleNavigate comment. AttachClient on the page-level host
+                // is the whole session; empty-sessionId routes to the main
+                // (renderer) session directly.
+                base::DictValue call;
+                call.Set("id", e_id);
+                call.Set("method", "Runtime.evaluate");
+                base::DictValue cparams;
+                cparams.Set("expression", code_expr);
+                cparams.Set("returnByValue", true);
+                cparams.Set("awaitPromise", false);
+                call.Set("params", std::move(cparams));
+                std::string line;
+                base::JSONWriter::Write(base::Value(std::move(call)), &line);
+                self->eval_agent_->DispatchProtocolMessage(
+                    self, base::as_byte_span(line));
+              },
+              this, eid, tid, expr));
+}
+
+
+void SumeruGateway::DispatchProtocolMessage(
+    content::DevToolsAgentHost* agent_host,
+    base::span<const uint8_t> message) {
+ // Agent replies arrive on the UI thread; hop to IO where the pending map
+ // and socket live.
+  std::string text(message.begin(), message.end());
+  content::BrowserThread::GetTaskRunnerForThread(content::BrowserThread::IO)
+      ->PostTask(
+          FROM_HERE,
+          base::BindOnce(
+              [](base::WeakPtr<SumeruGateway> self, std::string msg) {
+                if (self) {
+                  self->HandleAgentReply(msg);
+                }
+              },
+              weak_factory_.GetWeakPtr(), std::move(text)));
+}
+
+void SumeruGateway::HandleAgentReply(const std::string& text) {
+ // Parse the CDP reply, match our tracked id, resolve the pending request.
+  auto parsed = base::JSONReader::Read(text, /*options=*/0);
+  if (!parsed || !parsed->is_dict()) {
+    return;
+  }
+  const base::DictValue& msg = parsed->GetDict();
+ // fix (2026-11-19): no child-session capture — commands dispatch with
+ // an empty sessionId to the main session; replies resolve by tracked id.
+ //
+ // navigate fix: Page.loadEventFired is the completion signal for navigateTarget.
+  if (const std::string* ev_method = msg.FindString("method")) {
+    if (*ev_method == "Page.loadEventFired") {
+      ResolveCommittedNavs();
+    }
+    return;
+  }
+  std::optional<double> idv = msg.FindDouble("id");
+  if (!idv) {
+    return;  // Other events: gateway event-stream territory, not needed for eval.
+  }
+  int eid = static_cast<int>(*idv);
+  auto it = eval_pending_.find(eid);
+  if (it == eval_pending_.end()) {
+    return;
+  }
+ // navigate fix: the navigate command answered — error fails now, success waits
+ // for the load event so a following evaluate sees the NEW document.
+  if (nav_awaiting_commit_.erase(eid)) {
+    bool failed = false;
+    std::string emsg = "navigate failed";
+    if (const base::Value* ev = msg.Find("error")) {
+      failed = true;
+      if (ev->is_dict()) {
+        if (const std::string* m = ev->GetDict().FindString("message")) {
+          emsg = *m;
+        }
+      }
+    }
+    if (failed) {
+      double nreq = it->second.req_id;
+      eval_pending_.erase(it);
+      nav_awaiting_load_.erase(eid);
+      base::DictValue resp;
+      resp.Set("type", "response");
+      resp.Set("id", nreq);
+      resp.Set("ok", false);
+      base::DictValue e;
+      e.Set("code", "GW_NAVIGATE_ERROR");
+      e.Set("message", emsg);
+      resp.Set("error", std::move(e));
+      Send(base::Value(std::move(resp)));
+      return;
+    }
+    nav_awaiting_load_.insert(eid);
+    return;  // Response deferred to Page.loadEventFired.
+  }
+  double req_id = it->second.req_id;
+  eval_pending_.erase(it);
+
+  base::DictValue resp;
+  resp.Set("type", "response");
+  resp.Set("id", req_id);
+  const base::Value* result = nullptr;
+  const base::Value* error = nullptr;
+  if (parsed->is_dict()) {
+    if (const base::Value* rv = parsed->GetDict().Find("result")) {
+      result = rv;
+    }
+    if (const base::Value* ev = parsed->GetDict().Find("error")) {
+      error = ev;
+    }
+  }
+  if (error) {
+    resp.Set("ok", false);
+    base::DictValue e;
+    std::string emsg = "eval error";
+    if (error->is_dict()) {
+      if (const std::string* m = error->GetDict().FindString("message")) {
+        emsg = *m;
+      }
+    }
+    e.Set("code", "GW_EVAL_ERROR");
+    e.Set("message", emsg);
+    resp.Set("error", std::move(e));
+    Send(base::Value(std::move(resp)));
+    return;
+  }
+ // result.result.value (returnByValue) or exceptionDetails.
+  const base::Value* inner = nullptr;
+  const base::Value* exc = nullptr;
+  if (result && result->is_dict()) {
+    if (const base::Value* iv = result->GetDict().Find("result")) {
+      inner = iv;
+    }
+    if (const base::Value* xv = result->GetDict().Find("exceptionDetails")) {
+      exc = xv;
+    }
+  }
+  if (exc) {
+    resp.Set("ok", false);
+    base::DictValue e;
+    e.Set("code", "SUMERU_OPERATION_FAILED");
+    e.Set("message", "eval exception");
+    resp.Set("error", std::move(e));
+    Send(base::Value(std::move(resp)));
+    return;
+  }
+  resp.Set("ok", true);
+ // Unwrap the CDP RemoteObject: {"type":"string","value":...}. By-value
+ // results carry the JS value under "value"; fall back to the object itself
+ // for non-value returns.
+  base::Value value;
+  if (inner && inner->is_dict()) {
+    if (const base::Value* v = inner->GetDict().Find("value")) {
+      value = v->Clone();
+    } else {
+      value = inner->Clone();
+    }
+  } else if (inner) {
+    value = inner->Clone();
+  }
+  base::DictValue r;
+  r.Set("value", std::move(value));
+  resp.Set("result", std::move(r));
+  Send(base::Value(std::move(resp)));
+}
+
+void SumeruGateway::ResolveCommittedNavs() {
+ // IO thread: Page.loadEventFired arrived — the new document is usable.
+  for (auto sit = nav_awaiting_load_.begin();
+       sit != nav_awaiting_load_.end();) {
+    int eid = *sit;
+    auto it = eval_pending_.find(eid);
+    if (it == eval_pending_.end()) {
+      sit = nav_awaiting_load_.erase(sit);
+      continue;
+    }
+    double req_id = it->second.req_id;
+    eval_pending_.erase(it);
+    base::DictValue resp;
+    resp.Set("type", "response");
+    resp.Set("id", req_id);
+    resp.Set("ok", true);
+    base::DictValue r;
+    r.Set("navigated", true);
+    resp.Set("result", std::move(r));
+    Send(base::Value(std::move(resp)));
+    sit = nav_awaiting_load_.erase(sit);
+  }
+}
+
+void SumeruGateway::FailAllPending() {
+ // IO-thread only: eval_pending_ and the socket live here. The old
+ // AgentHostClosed() wrote the socket from the UI thread, which trips
+ // SocketPosix's thread checker and aborts the browser when a tab with an
+ // in-flight evaluate is closed (socket-thread fix).
+  DCHECK_CURRENTLY_ON(content::BrowserThread::IO);
+  for (auto& entry : eval_pending_) {
+    const PendingEval& pe = entry.second;
+    base::DictValue resp;
+    resp.Set("type", "response");
+    resp.Set("id", pe.req_id);
+    resp.Set("ok", false);
+    base::DictValue e;
+    e.Set("code", "SUMERU_OPERATION_FAILED");
+    e.Set("message", "agent host closed");
+    resp.Set("error", std::move(e));
+    Send(base::Value(std::move(resp)));
+  }
+  eval_pending_.clear();
+  nav_awaiting_commit_.clear();
+  nav_awaiting_load_.clear();
+}
+
+void SumeruGateway::AgentHostClosed(content::DevToolsAgentHost* agent_host) {
+  if (eval_agent_ && eval_agent_.get() != agent_host) {
+    return;  // A different host; ignore.
+  }
+ // UI thread: only clear the agent pointer. Pending-map cleanup and socket
+ // writes are IO-thread work (see FailAllPending above).
+  eval_agent_ = nullptr;
+  content::BrowserThread::GetTaskRunnerForThread(content::BrowserThread::IO)
+      ->PostTask(FROM_HERE,
+                 base::BindOnce(&SumeruGateway::FailAllPending,
+                                weak_factory_.GetWeakPtr()));
+}
+
+
+void SumeruGateway::CloseConnection() {
+  if (client_) {
+    client_->Disconnect();
+    client_.reset();
+  }
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&SumeruGateway::DoAcceptLoop,
+                                weak_factory_.GetWeakPtr()));
+}
+
+}  // namespace content::sumeru
+
+
+
+
+
+
