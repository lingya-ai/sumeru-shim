+// Copyright 2026 The Sumeru Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/sumeru/tabs/sumeru_last_tab_guard.h"
+
+#include <cstdlib>
+#include <string>
+
+#include "chrome/browser/lifetime/browser_shutdown.h"
+#include "sumeru/browser/tabs/tab_ops.h"
+
+namespace sumeru {
+
+bool ShouldBlockLastTabClose(int tab_count) {
+  if (tab_count > 1) {
+    return false;
+  }
+  if (!content::sumeru::IsKeepLastTabEnabled()) {
+    return false;
+  }
+ // Shutdown must complete: blocking here would turn `docker stop` into a
+ // fifteen-second grace period followed by SIGKILL, losing the profile writes
+ // that make tabs/cookies survive a restart.
+  if (browser_shutdown::IsTryingToQuit()) {
+    return false;
+  }
+  return true;
+}
+
+}  // namespace sumeru
diff --git a/chrome/browser/sumeru/tabs/sumeru_last_tab_guard.h b/chrome/browser/sumeru/tabs/sumeru_last_tab_guard.h
