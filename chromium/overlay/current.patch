+// Copyright 2026 The Sumeru Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef SUMERU_BROWSER_TABS_TAB_OPS_H_
+#define SUMERU_BROWSER_TABS_TAB_OPS_H_
+
+#include <string>
+#include <vector>
+
+#include "url/gurl.h"
+
+namespace content {
+class WebContents;
+}
+
+namespace content::sumeru {
+
+struct TabSnapshot {
+  std::string target_id;
+  std::string url;
+  std::string title;
+  bool active = false;
+};
+
+// Gateway: agent tab operations are browser-domain (TabStripModel), not a
+// private registry. content/ cannot reach the chrome embedder, so the embedder
+// installs this delegate during startup. When no delegate is installed the
+// gateway falls back to TabRegistry (content-only builds and tests).
+//
+// All methods must be called on the UI thread.
+class TabOpsDelegate {
+ public:
+  virtual ~TabOpsDelegate() = default;
+
+ // Creates a tab and returns its DevTools target id ("" on failure).
+  virtual std::string CreateTab(const GURL& url) = 0;
+  virtual bool CloseTab(const std::string& target_id) = 0;
+  virtual bool ActivateTab(const std::string& target_id) = 0;
+  virtual std::vector<TabSnapshot> ListTabs() = 0;
+ // Target id of the active tab ("" when unknown).
+  virtual std::string GetActiveTargetId() = 0;
+ // Number of tabs currently in the strip (0 when unknown).
+  virtual int TabCount() = 0;
+  virtual WebContents* GetWebContents(const std::string& target_id) = 0;
+};
+
+// UI thread only. Does not take ownership; the embedder keeps the delegate
+// alive for the process lifetime.
+void SetTabOpsDelegate(TabOpsDelegate* delegate);
+TabOpsDelegate* GetTabOpsDelegate();
+
+// The product keeps at least one tab open so the browser cannot exit because
+// its last tab was closed. Enabled unless SUMERU_KEEP_LAST_TAB=0.
+bool IsKeepLastTabEnabled();
+
+}  // namespace content::sumeru
+
+#endif  // SUMERU_BROWSER_TABS_TAB_OPS_H_
diff --git a/sumeru/browser/tabs/tab_registry.cc b/sumeru/browser/tabs/tab_registry.cc
new file mode 100644
index 0000000..36415b7
--- /dev/null
+++ b/sumeru/browser/tabs/tab_registry.cc
@@ -0,0 +1,115 @@
+// Copyright 2026 The Sumeru Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "sumeru/browser/tabs/tab_registry.h"
+
+#include <map>
+#include <utility>
+
+#include "base/no_destructor.h"
+#include "base/strings/utf_string_conversions.h"
+#include "content/public/browser/devtools_agent_host.h"
+#include "content/public/browser/web_contents.h"
+
+namespace content::sumeru {
+
+namespace {
+
+struct Slot {
+  std::unique_ptr<content::WebContents> contents;
+  std::string target_id;
+  bool active = false;
+};
+
+// 进程内单例。用 base::NoDestructor 避免 exit-time destructor
+// （本项目 -Werror,-Wexit-time-destructors）。
+using Registry = std::map<std::string, Slot>;
+
+Registry& GetRegistry() {
+  static base::NoDestructor<Registry> registry;
+  return *registry;
+}
+
+// DevTools agent host id 与 CDP 用的是同一套字符串（`<type>:<uuid>`），
+// 这样 createTab() 的返回值能和 harness 已经期待的 target id 互通。
+std::string TargetIdFor(content::WebContents* contents) {
+  if (!contents) {
+    return std::string();
+  }
+  auto agent_host = content::DevToolsAgentHost::GetOrCreateFor(contents);
+  return agent_host ? agent_host->GetId() : std::string();
+}
+
+}  // namespace
+
+std::string TabRegistry::Register(
+    std::unique_ptr<content::WebContents> contents) {
+  if (!contents) {
+    return std::string();
+  }
+  const std::string target_id = TargetIdFor(contents.get());
+  if (target_id.empty()) {
+    return std::string();
+  }
+  Slot slot;
+  slot.target_id = target_id;
+  slot.contents = std::move(contents);
+  GetRegistry()[target_id] = std::move(slot);
+  return target_id;
+}
+
+std::vector<TabRegistry::Entry> TabRegistry::List() {
+  std::vector<Entry> entries;
+ // active 语义：本注册表里最后一个被 SetActive 的；默认第一个。
+  bool any_active = false;
+  for (const auto& [id, slot] : GetRegistry()) {
+    if (slot.active) {
+      any_active = true;
+      break;
+    }
+  }
+  bool first = true;
+  for (const auto& [id, slot] : GetRegistry()) {
+    Entry entry;
+    entry.target_id = id;
+    if (slot.contents) {
+      entry.url = slot.contents->GetLastCommittedURL().spec();
+      // sumeru 的 TabInfo 返回页面标题（title），不是 url。
+      entry.title = base::UTF16ToUTF8(slot.contents->GetTitle());
+    }
+    // 本注册表只登记经 sumeru NodeClient（agent）创建的 tab，
+    // 所以 opened_by 恒为 "agent"。
+    entry.opened_by = "agent";
+    // label 由 SDK 层分配（p1、p2…），内核侧为空。
+    entry.label = std::string();
+    if (any_active) {
+      entry.active = slot.active;
+    } else {
+      entry.active = first;
+    }
+    first = false;
+    entries.push_back(std::move(entry));
+  }
+  return entries;
+}
+
+bool TabRegistry::Close(const std::string& target_id) {
+  auto it = GetRegistry().find(target_id);
+  if (it == GetRegistry().end()) {
+    return false;
+  }
+  if (it->second.contents) {
+    it->second.contents->Close();
+  }
+  GetRegistry().erase(it);
+  return true;
+}
+
+void TabRegistry::SetActive(const std::string& target_id) {
+  for (auto& [id, slot] : GetRegistry()) {
+    slot.active = (id == target_id);
+  }
+}
+
+}  // namespace content::sumeru
