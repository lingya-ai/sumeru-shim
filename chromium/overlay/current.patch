+++ b/content/browser/renderer_host/sumeru_page_capture.cc
@@ -0,0 +1,79 @@
+// Copyright 2026 The Sumeru Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "content/public/browser/sumeru_page_capture.h"
+
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/logging.h"
+#include "base/time/time.h"
+#include "components/viz/common/frame_sinks/copy_output_result.h"
+#include "content/browser/renderer_host/render_widget_host_view_base.h"
+#include "content/public/browser/render_widget_host_view.h"
+#include "content/public/browser/web_contents.h"
+#include "ui/gfx/codec/png_codec.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/gfx/geometry/size.h"
+
+namespace content::sumeru {
+namespace {
+
+// 5 s covers the first frame after a tab activation (capture) and still keeps a
+// broken viz path from hanging the gateway request forever.
+constexpr base::TimeDelta kCaptureTimeout = base::Seconds(5);
+
+void OnCopied(CapturePagePngCallback callback,
+              const content::CopyFromSurfaceResult& result) {
+  if (!result.has_value()) {
+    LOG(ERROR) << "[SUMERU-CAPTURE] CopyFromSurface failed code="
+               << static_cast<int>(result.error());
+    std::move(callback).Run(std::vector<uint8_t>(), false);
+    return;
+  }
+  const SkBitmap& bitmap = result.value().bitmap;
+  if (bitmap.isNull() || bitmap.empty()) {
+    LOG(ERROR) << "[SUMERU-CAPTURE] empty bitmap";
+    std::move(callback).Run(std::vector<uint8_t>(), false);
+    return;
+  }
+ // This tree's PNGCodec returns std::optional<std::vector<uint8_t>>.
+  std::optional<std::vector<uint8_t>> encoded =
+      gfx::PNGCodec::EncodeBGRASkBitmap(bitmap, /*discard_transparency=*/false);
+  if (!encoded || encoded->empty()) {
+    LOG(ERROR) << "[SUMERU-CAPTURE] png encode failed";
+    std::move(callback).Run(std::vector<uint8_t>(), false);
+    return;
+  }
+  std::vector<uint8_t> png = std::move(*encoded);
+  LOG(ERROR) << "[SUMERU-CAPTURE] ok " << bitmap.width() << "x"
+             << bitmap.height() << " png=" << png.size();
+  std::move(callback).Run(std::move(png), true);
+}
+
+}  // namespace
+
+void CapturePagePng(WebContents* contents, CapturePagePngCallback callback) {
+  if (!contents) {
+    std::move(callback).Run(std::vector<uint8_t>(), false);
+    return;
+  }
+  RenderWidgetHostView* view = contents->GetRenderWidgetHostView();
+  if (!view) {
+    LOG(ERROR) << "[SUMERU-CAPTURE] no RenderWidgetHostView";
+    std::move(callback).Run(std::vector<uint8_t>(), false);
+    return;
+  }
+ // The public view interface has no CopyFromSurface; the platform base
+ // implementation does (content/browser internal is fine inside content).
+  auto* base_view = static_cast<RenderWidgetHostViewBase*>(view);
+  base_view->CopyFromSurface(
+      gfx::Rect(), gfx::Size(), kCaptureTimeout,
+      base::BindOnce(&OnCopied, std::move(callback)));
+}
+
+}  // namespace content::sumeru
+
+
+
