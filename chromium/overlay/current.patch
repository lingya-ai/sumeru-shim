+void SumeruGateway::HandleImeCompose(const base::DictValue& params,
+                                      double req_id) {
+  const std::string* target_id = params.FindString("targetId");
+  const std::string* text = params.FindString("text");
+  const std::string* commit = params.FindString("commit");
+  const std::optional<int> sel = params.FindInt("selectionStart");
+  if (!target_id || target_id->empty() || !text) {
+    base::DictValue resp;
+    resp.Set("type", "response");
+    resp.Set("id", req_id);
+    resp.Set("ok", false);
+    base::DictValue e;
+    e.Set("code", "GW_INVALID_ARGUMENT");
+    e.Set("message", "targetId and text required");
+    resp.Set("error", std::move(e));
+    Send(base::Value(std::move(resp)));
+    return;
+  }
+  const std::string tid = *target_id;
+  const std::u16string text16 = base::UTF8ToUTF16(*text);
+  const std::u16string commit16 = commit ? base::UTF8ToUTF16(*commit) : std::u16string();
+  const int sel_start = sel.value_or(static_cast<int>(text16.size()));
+  const int sel_end = sel_start;
+  content::BrowserThread::GetTaskRunnerForThread(content::BrowserThread::UI)
+      ->PostTask(
+          FROM_HERE,
+          base::BindOnce(
+              [](SumeruGateway* self, double req_id, const std::string& t_id,
+                 const std::u16string& comp, const std::u16string& commit,
+                 int sel_start, int sel_end) {
+                // K3 gap #3: the browser input pipeline (the CDP
+                // InputHandler's RenderWidgetHost pattern — isTrusted on the
+                // page).
+                content::WebContents* matched = ResolveTargetContents(t_id);
+                auto send_resp = [&](bool ok, const std::string& code,
+                                     const std::string& message) {
+                  base::DictValue resp;
+                  resp.Set("type", "response");
+                  resp.Set("id", req_id);
+                  resp.Set("ok", ok);
+                  if (ok) {
+                    base::DictValue r;
+                    r.Set("composed", base::UTF16ToUTF8(comp));
+                    r.Set("committed", base::UTF16ToUTF8(commit));
+                    resp.Set("result", std::move(r));
+                  } else {
+                    base::DictValue e;
+                    e.Set("code", code);
+                    e.Set("message", message);
+                    resp.Set("error", std::move(e));
+                  }
+                  content::BrowserThread::GetTaskRunnerForThread(
+                      content::BrowserThread::IO)
+                      ->PostTask(FROM_HERE,
+                                 base::BindOnce(
+                                     [](SumeruGateway* self,
+                                        base::Value msg) {
+                                       self->Send(std::move(msg));
+                                     },
+                                     self, base::Value(std::move(resp))));
+                };
+                if (!matched || !matched->GetPrimaryMainFrame()) {
+                  send_resp(false, "SUMERU_TASK_SPACE_NOT_FOUND",
+                            "no target: " + t_id);
+                  return;
+                }
+                auto* widget_host = static_cast<content::RenderWidgetHostImpl*>(
+                    matched->GetPrimaryMainFrame()->GetRenderWidgetHost());
+                if (!widget_host) {
+                  send_resp(false, "SUMERU_OPERATION_FAILED",
+                            "no render widget host");
+                  return;
+                }
+                widget_host->Focus();
+                if (!comp.empty()) {
+                  widget_host->GetWidgetInputHandler()->ImeSetComposition(
+                      comp, std::vector<ui::ImeTextSpan>(),
+                      gfx::Range::InvalidRange(), sel_start, sel_end,
+                      blink::mojom::ImeState::kNone, blink::DOMNodeIdType(),
+                      base::OnceClosure());
+                }
+                if (!commit.empty()) {
+                  widget_host->GetWidgetInputHandler()->ImeCommitText(
+                      commit, std::vector<ui::ImeTextSpan>(),
+                      gfx::Range::InvalidRange(), 0, blink::DOMNodeIdType(),
+                      base::OnceClosure());
+                }
+                send_resp(true, "", "");
+              },
+              this, req_id, tid, text16, commit16, sel_start, sel_end));
+}
+
+
+void SumeruGateway::HandleDispatchKey(const base::DictValue& params,
+                                       double req_id) {
+  const std::string* target_id = params.FindString("targetId");
+  const std::string* type = params.FindString("type");
+  if (!target_id || target_id->empty() || !type) {
+    base::DictValue resp;
+    resp.Set("type", "response");
+    resp.Set("id", req_id);
+    resp.Set("ok", false);
+    base::DictValue e;
+    e.Set("code", "GW_INVALID_ARGUMENT");
+    e.Set("message", "targetId and type required");
+    resp.Set("error", std::move(e));
+    Send(base::Value(std::move(resp)));
+    return;
+  }
+  const std::string tid = *target_id;
+  const std::string key_type = *type;
+  const std::string key = params.FindString("key") ? *params.FindString("key") : "";
+  const std::string code = params.FindString("code") ? *params.FindString("code") : "";
+  const std::string key_text = params.FindString("text") ? *params.FindString("text") : "";
+  const int wvk = params.FindInt("windowsVirtualKeyCode").value_or(0);
+  const int nvk = params.FindInt("nativeVirtualKeyCode").value_or(0);
+  content::BrowserThread::GetTaskRunnerForThread(content::BrowserThread::UI)
+      ->PostTask(
+          FROM_HERE,
+          base::BindOnce(
+              [](SumeruGateway* self, double req_id, const std::string& t_id,
+                 const std::string& key_type, const std::string& key,
+                 const std::string& code, const std::string& key_text,
+                 int wvk, int nvk) {
+                auto send_resp = [&](bool ok, const std::string& code_e,
+                                     const std::string& message,
+                                     const std::string& dispatched) {
+                  base::DictValue resp;
+                  resp.Set("type", "response");
+                  resp.Set("id", req_id);
+                  resp.Set("ok", ok);
+                  if (ok) {
+                    base::DictValue r;
+                    r.Set("dispatched", dispatched);
+                    resp.Set("result", std::move(r));
+                  } else {
+                    base::DictValue e;
+                    e.Set("code", code_e);
+                    e.Set("message", message);
+                    resp.Set("error", std::move(e));
+                  }
+                  content::BrowserThread::GetTaskRunnerForThread(
+                      content::BrowserThread::IO)
+                      ->PostTask(FROM_HERE,
+                                 base::BindOnce(
+                                     [](SumeruGateway* self,
+                                        base::Value msg) {
+                                       self->Send(std::move(msg));
+                                     },
+                                     self, base::Value(std::move(resp))));
+                };
+                blink::WebInputEvent::Type web_type;
+                if (key_type == "keyDown") {
+                  web_type = blink::WebInputEvent::Type::kKeyDown;
+                } else if (key_type == "keyUp") {
+                  web_type = blink::WebInputEvent::Type::kKeyUp;
+                } else if (key_type == "char") {
+                  web_type = blink::WebInputEvent::Type::kChar;
+                } else if (key_type == "rawKeyDown") {
+                  web_type = blink::WebInputEvent::Type::kRawKeyDown;
+                } else {
+                  send_resp(false, "GW_INVALID_ARGUMENT",
+                            "type must be keyDown|keyUp|rawKeyDown|char", "");
+                  return;
+                }
+                content::WebContents* matched = ResolveTargetContents(t_id);
+                if (!matched || !matched->GetPrimaryMainFrame()) {
+                  send_resp(false, "SUMERU_TASK_SPACE_NOT_FOUND",
+                            "no target: " + t_id, "");
+                  return;
+                }
+                auto* widget_host = static_cast<content::RenderWidgetHostImpl*>(
+                    matched->GetPrimaryMainFrame()->GetRenderWidgetHost());
+                if (!widget_host) {
+                  send_resp(false, "SUMERU_OPERATION_FAILED",
+                            "no render widget host", "");
+                  return;
+                }
+                input::NativeWebKeyboardEvent event(
+                    web_type, blink::WebInputEvent::kNoModifiers,
+                    base::TimeTicks::Now());
+                if (!key_text.empty()) {
+                  // text is std::array<char16_t, kTextLengthCap> — copy, no
+                  // operator= for strings.
+                  const auto u16 = base::UTF8ToUTF16(key_text);
+                  const size_t n = std::min(u16.size(), size_t{15});
+                  for (size_t k = 0; k < n; ++k) event.text[k] = u16[k];
+                }
+                if (!code.empty()) {
+                  event.dom_code = static_cast<int>(
+                      ui::KeycodeConverter::CodeStringToDomCode(code));
+                }
+                if (!key.empty()) {
+                  event.dom_key = static_cast<int>(
+                      ui::KeycodeConverter::KeyStringToDomKey(key));
+                }
+                if (wvk) event.windows_key_code = wvk;
+                if (nvk) event.native_key_code = nvk;
+                widget_host->Focus();
+                widget_host->ForwardKeyboardEventWithLatencyInfo(
+                    event, ui::LatencyInfo());
+                send_resp(true, "", "", key_type);
+              },
+              this, req_id, tid, key_type, key, code, key_text, wvk, nvk));
+}
+
