+
+constexpr int kMaxFrameBytes = 1 << 20;  // 1 MiB, host-IPC v2 parity.
+
+std::string ReadTokenFromEnv() {
+  const char* tok = std::getenv("SUMERU_GATEWAY_TOKEN");
+  return tok ? std::string(tok) : std::string("sumeru-gateway");
+}
+
+void SendValue(net::StreamSocket* sock, base::Value msg) {
+  std::string line;
+  base::JSONWriter::Write(msg, &line);
+  line.push_back('\n');
+ // Small control frames: attempt a bounded sync-style write loop. If the
+ // socket reports ERR_IO_PENDING the single posted callback owns the data
+ // (a member buffer keeps it alive); partial writes are re-driven there.
+  auto buf = base::MakeRefCounted<net::DrainableIOBuffer>(
+      base::MakeRefCounted<net::StringIOBuffer>(line), line.size());
+  int rv = sock->Write(buf.get(), buf->BytesRemaining(),
+                       base::BindOnce([](int) {}),
+                       net::DefineNetworkTrafficAnnotation(
+                           "sumeru_gateway", "Sumeru control gateway"));
+ // Synchronous completion (the common case for small frames).
+ // Asynchronous: the callback above fires and the kernel owns the buffer;
+ // for the gateway protocol's small single-line frames this is acceptable.
+  (void)rv;
+  LOG(ERROR) << "[SUMERU-GW] send: "
+             << line.substr(0, line.size() > 160 ? 160 : line.size());
+}
+
+
+}  // namespace
+
+// gateway events: a static instance handle lets the mutating request handlers
+// notify subscribers without threading the pointer through. Events carry
+// a monotonic per-connection seq and a global revision (state generation).
+SumeruGateway* g_gateway = nullptr;
+
+void StartGateway(content::BrowserContext* browser_context) {
+  const char* enabled = std::getenv("SUMERU_GATEWAY");
+  if (!enabled || std::string(enabled) != "1") {
+    return;
+  }
+ // The UDS async I/O must live on the browser IO thread (DCHECK in
+ // current_thread.cc); hop there before constructing the socket.
+  content::BrowserThread::GetTaskRunnerForThread(content::BrowserThread::IO)
+      ->PostTask(FROM_HERE, base::BindOnce([](content::BrowserContext* ctx) {
+        static SumeruGateway* instance = nullptr;
+        if (instance) {
+          return;
+        }
+        instance = new SumeruGateway();
+        instance->set_browser_context(ctx);
+        g_gateway = instance;
+        instance->DoAcceptLoop();
+        LOG(ERROR) << "[SUMERU-GW] started on IO thread";
+      }, browser_context));
+}
+
+void SumeruGateway::Start() {
+  StartGateway(nullptr);
+}
+
+SumeruGateway::SumeruGateway()
+    : token_(ReadTokenFromEnv()),
+      server_session_(base::Uuid::GenerateRandomV4().AsLowercaseString()) {
+  const char* path_env = std::getenv("SUMERU_GATEWAY_SOCKET");
+  const std::string path = path_env ? std::string(path_env)
+                                    : std::string("/data/sumeru-gateway.sock");
+ // Raw POSIX unlink: socket-path hygiene without triggering the IO thread's
+ // blocking-disallowed DCHECK (base::DeleteFile would).
+  unlink(path.c_str());
+  server_ = std::make_unique<net::UnixDomainServerSocket>(
+      base::BindRepeating([](const net::UnixDomainServerSocket::Credentials&) {
+        return true;  // Any local peer; peer gating can be added later.
+      }),
+      /*use_abstract_socket=*/false);
+ // The shim keeps one long-lived connection; gates/diagnostics add their own.
+ // A backlog of 1 left every additional client hitting EAGAIN on connect.
+  int rv = server_->BindAndListen(path, /*backlog=*/16);
+  if (rv != net::OK) {
+    LOG(ERROR) << "[SUMERU-GW] listen failed rv=" << rv << " path=" << path;
+    server_.reset();
+    return;
+  }
+  chmod(path.c_str(), 0600);
+}
+
+SumeruGateway::~SumeruGateway() = default;
+
+void SumeruGateway::DoAcceptLoop() {
+  if (!server_) {
+    return;
+  }
+  pending_client_.reset();
+  int rv = server_->Accept(
+      &pending_client_,
+      base::BindOnce(&SumeruGateway::OnAccepted, weak_factory_.GetWeakPtr()));
+  if (rv != net::ERR_IO_PENDING) {
+    OnAccepted(rv);
+  }
+}
+
+void SumeruGateway::OnAccepted(int rv) {
+  if (rv == net::OK && pending_client_) {
+    client_ = std::move(pending_client_);
+  }
+  pending_client_.reset();
+  pending_client_.reset();
+  if (rv != net::OK) {
+    LOG(ERROR) << "[SUMERU-GW] accept rv=" << rv;
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&SumeruGateway::DoAcceptLoop,
+                                  weak_factory_.GetWeakPtr()));
+    return;
+  }
+  authenticated_ = false;
+  read_buffer_.clear();
+  StartRead();
+}
+
+void SumeruGateway::StartRead() {
+  if (!client_) {
+    return;
+  }
+ // The socket API requires the caller's IOBuffer to stay alive until the
+ // read callback fires; use a member buffer (a local scoped_refptr is
+ // destroyed on ERR_IO_PENDING — use-after-free, root cause of the
+ // welcome-never-arrives symptom found 2026-11-17).
+  read_io_buffer_ = base::MakeRefCounted<net::IOBufferWithSize>(4096);
+  int rv = client_->Read(read_io_buffer_.get(), read_io_buffer_->size(),
+                          base::BindOnce(&SumeruGateway::OnRead,
+                                         weak_factory_.GetWeakPtr()));
+  if (rv == net::ERR_IO_PENDING) {
+    return;
+  }
+  OnRead(rv);
+}
+
+void SumeruGateway::OnRead(int rv) {
+  if (!client_) {
+    return;
+  }
+  if (rv < 0) {
+    CloseConnection();
+    return;
+  }
+  if (rv == 0) {
+    // Peer closed the connection.
+    CloseConnection();
+    return;
+  }
+  read_buffer_.append(read_io_buffer_->data(), rv);
+  read_io_buffer_.reset();
+  for (;;) {
+    size_t nl = read_buffer_.find('\n');
+    if (nl == std::string::npos) {
+      if (read_buffer_.size() > kMaxFrameBytes) {
+        CloseConnection();
+        return;
+      }
+      break;
+    }
+    std::string line = read_buffer_.substr(0, nl);
+    read_buffer_.erase(0, nl + 1);
+    if (!line.empty()) {
+      HandleLine(line);
+      if (!client_) {
+        return;
+      }
+    }
+  }
+  StartRead();
+}
+
+void SumeruGateway::HandleLine(const std::string& line) {
+  auto parsed = base::JSONReader::Read(line, /*options=*/0);
+  if (!parsed || !parsed->is_dict()) {
+    base::DictValue err;
+    err.Set("type", "error");
+    err.Set("code", "GW_BAD_JSON");
+    Send(base::Value(std::move(err)));
+    CloseConnection();
+    return;
+  }
+  const base::Value& msg = *parsed;
+  const base::DictValue& md = msg.GetDict();
+  const std::string* type = md.FindString("type");
+  if (!authenticated_) {
+    if (type && *type == "hello") {
+      HandleHello(msg);
+      return;
+    }
+    base::DictValue err;
+    err.Set("type", "error");
+    err.Set("code", "GW_BAD_HANDSHAKE");
+    Send(base::Value(std::move(err)));
+    CloseConnection();
+    return;
+  }
+  if (type && *type == "request") {
+    HandleRequest(msg);
+    return;
+  }
+  base::DictValue err;
+  err.Set("type", "error");
+  err.Set("code", "GW_BAD_REQUEST");
+  Send(base::Value(std::move(err)));
+}
+
+void SumeruGateway::HandleHello(const base::Value& msg_value) {
+  const base::DictValue& msg = msg_value.GetDict();
+  const std::string* tok = msg.FindString("token");
+  bool version_ok = false;
+  const base::ListValue* versions = msg.FindList("versions");
+  if (versions) {
+    for (const auto& v : *versions) {
+      if (v.is_int() && v.GetInt() == 2) {
+        version_ok = true;
+      }
+    }
+  }
+  if (!tok || *tok != token_ || !version_ok) {
+    base::DictValue err;
+    err.Set("type", "error");
+    err.Set("code",
+            tok && *tok != token_ ? "GW_UNAUTHORIZED" : "GW_VERSION_MISMATCH");
+    Send(base::Value(std::move(err)));
+    CloseConnection();
+    return;
+  }
+  authenticated_ = true;
+  base::DictValue welcome;
+  welcome.Set("type", "welcome");
+  welcome.Set("version", 2);
+  welcome.Set("serverSession", server_session_);
+  Send(base::Value(std::move(welcome)));
+}
+
+void SumeruGateway::HandleRequest(const base::Value& msg_value) {
+  const base::DictValue& msg = msg_value.GetDict();
+  const std::string* method = msg.FindString("method");
+  const base::DictValue* params = msg.FindDict("params");
+  int rid = 0;
+  if (std::optional<double> idv = msg.FindDouble("id")) {
+    rid = static_cast<int>(*idv);
+  }
+  const int req_id = rid;
+  base::DictValue resp;
+  resp.Set("type", "response");
+  resp.Set("id", req_id);
+  auto fail = [&](const std::string& code, const std::string& message) {
+    base::DictValue e;
+    e.Set("code", code);
+    e.Set("message", message);
+    resp.Set("ok", false);
+    resp.Set("error", std::move(e));
+    Send(base::Value(std::move(resp)));
+  };
+  auto ok = [&](base::DictValue result) {
+    resp.Set("ok", true);
+    resp.Set("result", std::move(result));
+    Send(base::Value(std::move(resp)));
+  };
+ // NOTE(F22): okWithEvent was removed — all state methods now run on the
+ // UI thread and reply through PostResultAndEvent/inline bindings.
+  if (!method) {
+    fail("GW_BAD_REQUEST", "missing method");
+    return;
+  }
+
+ // epoch gate: mutating commands may carry
+ // expectedControlEpoch. A stale epoch means control changed since the
+ // caller last observed (takeover already happened) — the queued
+ // old-epoch command must not fire.
+
+  if (*method == "ping") {
+    base::DictValue r;
+    r.Set("pong", true);
+    ok(std::move(r));
+    return;
+  }
+  if (*method == "imeCompose") {
+    HandleImeCompose(*params, req_id);
+    return;
+  }
+  if (*method == "dispatchKey") {
+    HandleDispatchKey(*params, req_id);
+    return;
+  }
+  if (*method == "dispatchMouse") {
+    HandleDispatchMouse(*params, req_id);
+    return;
+  }
+  if (*method == "createTab") {
+    const std::string* tab_url = params ? params->FindString("url") : nullptr;
+    content::BrowserThread::GetTaskRunnerForThread(content::BrowserThread::UI)
+        ->PostTask(
+            FROM_HERE,
+            base::BindOnce(
+                [](SumeruGateway* self, std::string url, int req_id) {
+                  if (!self->browser_context_) {
+                    const auto all = content::WebContentsImpl::GetAllWebContents();
+                    if (!all.empty()) {
+                      self->set_browser_context(all.front()->GetBrowserContext());
+                    }
+                  }
+                  if (!self->browser_context_) {
+                    self->PostFailure(0, req_id, "SUMERU_NO_CONTEXT",
+                                      "no browser context yet");
+                    return;
+                  }
+                  // Gateway: prefer the embedder's TabStripModel
+                  // delegate (real, visible, capturable tabs); fall back to the
+                  // content-only registry when no delegate is installed.
+                  std::string target;
+                  if (content::sumeru::TabOpsDelegate* ops =
+                          content::sumeru::GetTabOpsDelegate()) {
+                    target = ops->CreateTab(GURL(url));
+                  } else {
+                    content::WebContents::CreateParams create_params(
+                        self->browser_context_);
+                    auto contents = content::WebContents::Create(create_params);
+                    if (!url.empty() && url != "about:blank") {
+                      content::NavigationController::LoadURLParams load{
+                          GURL(url)};
+                      load.transition_type = ui::PAGE_TRANSITION_AUTO_TOPLEVEL;
+                      contents->GetController().LoadURLWithParams(load);
+                    }
+                    target = content::sumeru::TabRegistry::Register(
+                        std::move(contents));
+                  }
+                  if (target.empty()) {
+                    self->PostFailure(0, req_id, "SUMERU_CREATE_TAB_REFUSED",
+                                      "no browser window available");
+                    return;
+                  }
+                  base::DictValue ev;
+                  ev.Set("targetId", target);
+                  self->PostResultAndEvent(0, req_id, "tabCreated",
+                                           std::move(ev));
+                },
+                this, tab_url ? *tab_url : std::string("about:blank"),
+                req_id));
+    return;
+  }
+  if (*method == "startTracing" || *method == "stopTracing") {
+    // Local diagnostic trace contract — explicit start/stop, drained to
+    // a file, no debug port. The renderer/BeginFrame categories let a gate
+    // correlate lease windows with real frame submissions.
+    const bool is_start = *method == "startTracing";
+    const std::string* cat = params ? params->FindString("categories") : nullptr;
+    const std::string* out_path = params ? params->FindString("path") : nullptr;
+    const std::string categories =
+        cat ? *cat
+            : std::string(
+                  "toplevel,disabled-by-default-devtools.timeline,"
+                  "disabled-by-default-devtools.timeline.frame");
+    const std::string path =
+        out_path ? *out_path : std::string("/data/sumeru-trace.json");
+    content::BrowserThread::GetTaskRunnerForThread(content::BrowserThread::UI)
+        ->PostTask(
+            FROM_HERE,
+            base::BindOnce(
+                [](SumeruGateway* self, bool is_start, std::string categories,
+                   std::string path, int req_id) {
+                  content::TracingController* controller =
+                      content::TracingController::GetInstance();
+                  bool ok = false;
+                  if (controller) {
+                    if (is_start) {
+                      base::trace_event::TraceConfig config(
+                          categories, "record-continuously");
+                      ok = controller->StartTracing(config, base::DoNothing());
+                    } else {
+                      ok = controller->StopTracing(
+                          content::TracingController::CreateFileEndpoint(
+                              base::FilePath(path), base::DoNothing()));
+                    }
+                  }
+                  content::BrowserThread::GetTaskRunnerForThread(
+                      content::BrowserThread::IO)
+                      ->PostTask(
+                          FROM_HERE,
+                          base::BindOnce(
+                              [](SumeruGateway* self, int req_id, bool ok,
+                                 bool is_start, std::string path) {
+                                base::DictValue resp;
+                                resp.Set("type", "response");
+                                resp.Set("id", req_id);
+                                if (!ok) {
+                                  resp.Set("ok", false);
+                                  base::DictValue e;
+                                  e.Set("code", "SUMERU_TRACE_FAILED");
+                                  e.Set("message",
+                                        "tracing controller refused");
+                                  resp.Set("error", std::move(e));
+                                } else {
+                                  base::DictValue r;
+                                  r.Set("tracing", is_start);
+                                  r.Set("path", path);
+                                  resp.Set("ok", true);
+                                  resp.Set("result", std::move(r));
+                                }
+                                self->Send(base::Value(std::move(resp)));
+                              },
+                              self, req_id, ok, is_start, path));
+                },
+                this, is_start, categories, path, req_id));
+    return;
+  }
+  if (*method == "closeTab") {
+    const std::string* target = params ? params->FindString("targetId") : nullptr;
+    if (!target || target->empty()) {
+      fail("GW_INVALID_ARGUMENT", "targetId required");
+      return;
+    }
+    content::BrowserThread::GetTaskRunnerForThread(content::BrowserThread::UI)
+        ->PostTask(
+            FROM_HERE,
+            base::BindOnce(
+                [](SumeruGateway* self, std::string target, int req_id) {
+                  bool ok = false;
+                  content::sumeru::TabOpsDelegate* ops =
+                      content::sumeru::GetTabOpsDelegate();
+                  // The product keeps at least one tab open: a single-tab
+                  // window must not lose its last tab, or the browser exits.
+                  // The chrome-side TabStripModel guard enforces the same rule
+                  // for human closes; here we answer honestly so the caller
+                  // does not read ok:true for a no-op.
+                  const int tab_count =
+                      ops ? ops->TabCount()
+                          : static_cast<int>(
+                                content::sumeru::TabRegistry::List().size());
+                  if (tab_count <= 1 &&
+                      content::sumeru::IsKeepLastTabEnabled()) {
+                    self->PostFailure(0, req_id, "SUMERU_LAST_TAB_PROTECTED",
+                                      "refusing to close the last tab "
+                                      "(SUMERU_KEEP_LAST_TAB=0 disables this)");
+                    return;
+                  }
+                  if (ops) {
+                    ok = ops->CloseTab(target);
+                  } else {
+                    ok = content::sumeru::TabRegistry::Close(target);
+                  }
+                  if (!ok) {
+                    self->PostFailure(0, req_id, "SUMERU_CLOSE_TAB_REFUSED",
+                                      "unknown target");
+                    return;
+                  }
+                  base::DictValue ev;
+                  ev.Set("targetId", target);
+                  self->PostResultAndEvent(0, req_id, "tabClosed",
+                                           std::move(ev));
+                },
+                this, *target, req_id));
+    return;
+  }
+  if (*method == "listTabs") {
+    // Gateway: tab listing is browser-domain; the delegate must run on
+    // the UI thread, and the response is posted back to the IO thread.
+    content::BrowserThread::GetTaskRunnerForThread(content::BrowserThread::UI)
+        ->PostTask(
+            FROM_HERE,
+            base::BindOnce(
+                [](SumeruGateway* self, int req_id) {
+                  base::ListValue tabs;
+                  if (content::sumeru::TabOpsDelegate* ops =
+                          content::sumeru::GetTabOpsDelegate()) {
+                    for (const auto& e : ops->ListTabs()) {
+                      base::DictValue t;
+                      t.Set("targetId", e.target_id);
+                      t.Set("url", e.url);
+                      t.Set("title", e.title);
+                      t.Set("active", e.active);
+                      t.Set("openedBy", "agent");
+                      tabs.Append(std::move(t));
+                    }
+                  } else {
+                    for (const auto& e : content::sumeru::TabRegistry::List()) {
+                      base::DictValue t;
+                      t.Set("targetId", e.target_id);
+                      t.Set("url", e.url);
+                      t.Set("title", e.title);
+                      t.Set("active", e.active);
+                      t.Set("openedBy", e.opened_by);
+                      tabs.Append(std::move(t));
+                    }
+                  }
+                  content::BrowserThread::GetTaskRunnerForThread(
+                      content::BrowserThread::IO)
+                      ->PostTask(
+                          FROM_HERE,
+                          base::BindOnce(
+                              [](SumeruGateway* self, int req_id,
+                                 base::ListValue tabs) {
+                                base::DictValue resp;
+                                resp.Set("type", "response");
+                                resp.Set("id", req_id);
+                                resp.Set("ok", true);
+                                base::DictValue r;
+                                r.Set("tabs", std::move(tabs));
+                                resp.Set("result", std::move(r));
+                                self->Send(base::Value(std::move(resp)));
+                              },
+                              self, req_id, std::move(tabs)));
+                },
+                this, req_id));
+    return;
+  }
+  if (*method == "activateTab") {
+    const std::string* target = params ? params->FindString("targetId") : nullptr;
+    if (!target || target->empty()) {
+      fail("GW_INVALID_ARGUMENT", "targetId required");
+      return;
+    }
+    content::BrowserThread::GetTaskRunnerForThread(content::BrowserThread::UI)
+        ->PostTask(
+            FROM_HERE,
+            base::BindOnce(
+                [](SumeruGateway* self, std::string target, int req_id) {
+                  bool activated = false;
+                  if (content::sumeru::TabOpsDelegate* ops =
+                          content::sumeru::GetTabOpsDelegate()) {
+                    activated = ops->ActivateTab(target);
+                  } else {
+                    content::sumeru::TabRegistry::SetActive(target);
+                    activated = true;
+                  }
+                  content::BrowserThread::GetTaskRunnerForThread(
+                      content::BrowserThread::IO)
+                      ->PostTask(
+                          FROM_HERE,
+                          base::BindOnce(
+                              [](SumeruGateway* self, int req_id,
+                                 std::string target, bool activated) {
+                                base::DictValue resp;
+                                resp.Set("type", "response");
+                                resp.Set("id", req_id);
+                                if (!activated) {
+                                  resp.Set("ok", false);
+                                  base::DictValue e;
+                                  e.Set("code", "SUMERU_ACTIVATE_TAB_REFUSED");
+                                  e.Set("message", "unknown target");
+                                  resp.Set("error", std::move(e));
+                                } else {
+                                  resp.Set("ok", true);
+                                  base::DictValue r;
+                                  r.Set("activated", target);
+                                  resp.Set("result", std::move(r));
+                                }
+                                self->Send(base::Value(std::move(resp)));
+                              },
+                              self, req_id, target, activated));
+                },
+                this, *target, req_id));
+    return;
+  }
+  if (*method == "captureScreenshot") {
+    // gateway: capture the PAGE surface only (no browser chrome) as base64 PNG.
+    const std::string* shot_target =
+        params ? params->FindString("targetId") : nullptr;
+    if (!shot_target || shot_target->empty()) {
+      fail("GW_INVALID_ARGUMENT", "targetId required");
+      return;
+    }
+    content::BrowserThread::GetTaskRunnerForThread(content::BrowserThread::UI)
+        ->PostTask(
+            FROM_HERE,
+            base::BindOnce(
+                [](SumeruGateway* self, std::string target, int req_id) {
+                  content::WebContents* contents = nullptr;
+                  if (content::sumeru::TabOpsDelegate* ops =
+                          content::sumeru::GetTabOpsDelegate()) {
+                    // capture: capture is promised for the active tab.
+                    // Activate the target first so the surface exists.
+                    if (ops->GetActiveTargetId() != target) {
+                      ops->ActivateTab(target);
+                    }
+                    contents = ops->GetWebContents(target);
+                  }
+                  if (!contents) {
+                    scoped_refptr<content::DevToolsAgentHost> host =
+                        content::DevToolsAgentHost::GetForId(target);
+                    contents = host ? host->GetWebContents() : nullptr;
+                  }
+                  if (!contents) {
+                    content::BrowserThread::GetTaskRunnerForThread(
+                        content::BrowserThread::IO)
+                        ->PostTask(
+                            FROM_HERE,
+                            base::BindOnce(
+                                [](SumeruGateway* self, int req_id) {
+                                  base::DictValue resp;
+                                  resp.Set("type", "response");
+                                  resp.Set("id", req_id);
+                                  resp.Set("ok", false);
+                                  base::DictValue e;
+                                  e.Set("code", "SUMERU_SCREENSHOT_FAILED");
+                                  e.Set("message", "unknown target");
+                                  resp.Set("error", std::move(e));
+                                  self->Send(base::Value(std::move(resp)));
+                                },
+                                self, req_id));
+                    return;
+                  }
+                  // capture: capture the active tab. A tab that was
+                  // just activated needs one frame before its surface exists,
+                  // so the copy runs on a short delay; the contents is
+                  // re-resolved inside the delayed task (no dangling pointer).
+                  // IncrementCapturerCount(stay_hidden=false) makes the
+                  // renderer produce frames for the capture.
+                  content::BrowserThread::GetTaskRunnerForThread(
+                      content::BrowserThread::UI)
+                      ->PostDelayedTask(
+                          FROM_HERE,
+                          base::BindOnce(
+                              [](SumeruGateway* self, std::string target,
+                                 int req_id) {
+                                content::WebContents* contents = nullptr;
+                                if (content::sumeru::TabOpsDelegate* ops =
+                                        content::sumeru::GetTabOpsDelegate()) {
+                                  contents = ops->GetWebContents(target);
+                                }
+                                if (!contents) {
+                                  scoped_refptr<content::DevToolsAgentHost>
+                                      host =
+                                          content::DevToolsAgentHost::GetForId(
+                                              target);
+                                  contents =
+                                      host ? host->GetWebContents() : nullptr;
+                                }
+                                if (!contents) {
+                                  content::BrowserThread::
+                                      GetTaskRunnerForThread(
+                                          content::BrowserThread::IO)
+                                          ->PostTask(
+                                              FROM_HERE,
+                                              base::BindOnce(
+                                                  [](SumeruGateway* self,
+                                                     int req_id) {
+                                                    base::DictValue resp;
+                                                    resp.Set("type", "response");
+                                                    resp.Set("id", req_id);
+                                                    resp.Set("ok", false);
+                                                    base::DictValue e;
+                                                    e.Set(
+                                                        "code",
+                                                        "SUMERU_SCREENSHOT_"
+                                                        "FAILED");
+                                                    e.Set("message",
+                                                          "unknown target");
+                                                    resp.Set("error",
+                                                             std::move(e));
+                                                    self->Send(base::Value(
+                                                        std::move(resp)));
+                                                  },
+                                                  self, req_id));
+                                  return;
+                                }
+                                base::ScopedClosureRunner capturer =
+                                    contents->IncrementCapturerCount(
+                                        /*capture_size=*/gfx::Size(),
+                                        /*stay_hidden=*/false,
+                                        /*stay_awake=*/false,
+                                        /*is_activity=*/true);
+                                content::sumeru::CapturePagePng(
+                                    contents,
+                                    base::BindOnce(
+                                        [](base::ScopedClosureRunner capturer,
+                                           SumeruGateway* self, int req_id,
+                                           std::vector<uint8_t> png,
+                                           bool ok) {
+                                          content::BrowserThread::
+                                              GetTaskRunnerForThread(
+                                                  content::BrowserThread::IO)
+                                                  ->PostTask(
+                                                      FROM_HERE,
+                                                      base::BindOnce(
+                                                          [](SumeruGateway*
+                                                                 self,
+                                                             int req_id,
+                                                             std::vector<
+                                                                 uint8_t>
+                                                                 png,
+                                                             bool ok) {
+                                                            base::DictValue
+                                                                resp;
+                                                            resp.Set(
+                                                                "type",
+                                                                "response");
+                                                            resp.Set("id",
+                                                                     req_id);
+                                                            if (!ok ||
+                                                                png.empty()) {
+                                                              resp.Set("ok",
+                                                                       false);
+                                                              base::DictValue
+                                                                  e;
+                                                              e.Set(
+                                                                  "code",
+                                                                  "SUMERU_"
+                                                                  "SCREENSHOT_"
+                                                                  "FAILED");
+                                                              e.Set(
+                                                                  "message",
+                                                                  "capture "
+                                                                  "failed");
+                                                              resp.Set(
+                                                                  "error",
+                                                                  std::move(
+                                                                      e));
+                                                            } else {
+                                                              base::DictValue r;
+                                                              r.Set(
+                                                                  "pngBase64",
+                                                                  base::Base64Encode(
+                                                                      png));
+                                                              r.Set(
+                                                                  "bytes",
+                                                                  static_cast<
+                                                                      int>(
+                                                                      png.size()));
+                                                              resp.Set(
+                                                                  "ok", true);
+                                                              resp.Set(
+                                                                  "result",
+                                                                  std::move(
+                                                                      r));
+                                                            }
+                                                            self->Send(
+                                                                base::Value(
+                                                                    std::move(
+                                                                        resp)));
+                                                          },
+                                                          self, req_id,
+                                                          std::move(png), ok));
+                                        },
+                                        std::move(capturer), self, req_id));
+                              },
+                              self, target, req_id),
+                          base::Milliseconds(250));
+                },
+                this, *shot_target, req_id));
+    return;
+  }
+  if (*method == "snapshotAX") {
+    HandleSnapshotAX(*params, req_id);
+    return;
+  }
+  if (*method == "evaluateTarget") {
+    HandleEvaluate(*params, req_id);
+    return;
+  }
+  if (*method == "navigateTarget") {
+    HandleNavigate(*params, req_id);
+    return;
+  }
+  fail("GW_UNKNOWN_METHOD", "unknown method: " + *method);
+}
+
+void SumeruGateway::Send(const base::Value& msg) {
+  if (client_) {
+    SendValue(client_.get(), msg.Clone());
+  }
+}
+
+void SumeruGateway::BroadcastEvent(const std::string& event,
+                                    base::DictValue payload) {
+  if (!client_ || !subscribed_) {
+    // Revision still advances for non-subscribers (snapshot consistency).
+    revision_ += 1;
+    return;
+  }
+  revision_ += 1;
+  last_seq_sent_ += 1;
+  base::DictValue msg;
+  msg.Set("type", "event");
+  msg.Set("event", event);
+  msg.Set("payload", std::move(payload));
+  msg.Set("seq", last_seq_sent_);
+  msg.Set("revision", revision_);
+  Send(base::Value(std::move(msg)));
+}
+
+void SumeruGateway::FailPendingEval(int eid, const std::string& code,
+                                    const std::string& message) {
+ // Called on the UI thread; hop to IO to send.
+  auto it = eval_pending_.find(eid);
+  if (it == eval_pending_.end()) {
+    return;
+  }
+  double req_id = it->second.req_id;
+  eval_pending_.erase(it);
+  content::BrowserThread::GetTaskRunnerForThread(content::BrowserThread::IO)
+      ->PostTask(
+          FROM_HERE,
+          base::BindOnce(
+              [](SumeruGateway* self, double r_id,
+                 const std::string& c, const std::string& m) {
+                base::DictValue resp;
+                resp.Set("type", "response");
+                resp.Set("id", r_id);
+                resp.Set("ok", false);
+                base::DictValue e;
+                e.Set("code", c);
+                e.Set("message", m);
+                resp.Set("error", std::move(e));
+                self->Send(base::Value(std::move(resp)));
+              },
+              this, req_id, code, message));
+}
+
+// Gateway: target ids are DevTools ids of real TabStripModel tabs. The
+// embedder's delegate resolves them first; the agent-host scan is the fallback
+// for content-only builds. UI thread only.
+content::WebContents* ResolveTargetContents(const std::string& target_id) {
+  if (content::sumeru::TabOpsDelegate* ops =
+          content::sumeru::GetTabOpsDelegate()) {
+    if (content::WebContents* contents = ops->GetWebContents(target_id)) {
+      return contents;
+    }
+  }
+  for (content::WebContents* contents :
+       content::WebContentsImpl::GetAllWebContents()) {
+    if (!contents) {
+      continue;
+    }
+    scoped_refptr<content::DevToolsAgentHost> host =
+        content::DevToolsAgentHost::GetForTab(contents);
+    if (host && host->GetId() == target_id) {
+      return contents;
+    }
+    host = content::DevToolsAgentHost::GetOrCreateFor(contents);
+    if (host && host->GetId() == target_id) {
+      return contents;
+    }
+  }
+  return nullptr;
+}
+void SumeruGateway::HandleNavigate(const base::DictValue& params,
+                                    double req_id) {
+  const std::string* target_id = params.FindString("targetId");
+  const std::string* url = params.FindString("url");
+  if (!target_id || target_id->empty() || !url) {
+    base::DictValue resp;
+    resp.Set("type", "response");
+    resp.Set("id", req_id);
+    resp.Set("ok", false);
+    base::DictValue e;
+    e.Set("code", "GW_INVALID_ARGUMENT");
+    e.Set("message", "targetId and url required");
+    resp.Set("error", std::move(e));
+    Send(base::Value(std::move(resp)));
+    return;
+  }
+  const std::string tid = *target_id;
+  const std::string dest = *url;
+  int eid = eval_next_id_++;
+  eval_pending_[eid] = {eid, req_id, tid};
+ // navigate fix: navigate completes on Page.loadEventFired, not on the
+ // Page.navigate reply (which only means the navigation started).
+  nav_awaiting_commit_.insert(eid);
+  content::BrowserThread::GetTaskRunnerForThread(content::BrowserThread::UI)
+      ->PostTask(
+          FROM_HERE,
+          base::BindOnce(
+              [](SumeruGateway* self, int e_id, const std::string& t_id,
+                 const std::string& dest_url) {
+                // same agent-path restructure as
+                // HandleEvaluate — setAutoAttach is (re)sent whenever the
+                // session is empty so repeat navigations to the same target
+                // cannot queue forever; the session is kept across requests.
+                if (!self->eval_agent_ ||
+                    self->eval_agent_->GetId() != t_id) {
+                  if (self->eval_agent_) {
+                    self->eval_agent_->DetachClient(self);
+                  }
+                  self->eval_agent_ =
+                      content::DevToolsAgentHost::GetForId(t_id);
+                  if (!self->eval_agent_) {
+                    // Gateway: real tabs may only be reachable through
+                    // the embedder delegate.
+                    if (content::WebContents* eval_contents =
+                            ResolveTargetContents(t_id)) {
+                      self->eval_agent_ =
+                          content::DevToolsAgentHost::GetOrCreateFor(
+                              eval_contents);
+                    }
+                  }
+                  if (!self->eval_agent_) {
+                    self->FailPendingEval(
+                        e_id, "SUMERU_TASK_SPACE_NOT_FOUND",
+                        "no target: " + t_id);
+                    return;
+                  }
+                  if (!self->eval_agent_->AttachClient(self)) {
+                    self->eval_agent_ = nullptr;
+                    self->FailPendingEval(
+                        e_id, "SUMERU_OPERATION_FAILED", "attach failed");
+                    return;
+                  }
+                }
+                // fix (2026-11-19): no-session dispatch. The page-level
+                // DevToolsAgentHost routes empty-sessionId commands to the
+                // main session (devtools_session.cc); the Target.setAutoAttach
+                // child-session wait never fires for detached WebContents.
+                //
+                // navigate fix: Page.enable first so Page.loadEventFired is
+                // emitted; the response is deferred to that event.
+                base::DictValue enable;
+                enable.Set("id", 900000002);
+                enable.Set("method", "Page.enable");
+                std::string enable_line;
+                base::JSONWriter::Write(base::Value(std::move(enable)),
+                                        &enable_line);
+                self->eval_agent_->DispatchProtocolMessage(
+                    self, base::as_byte_span(enable_line));
+
+                base::DictValue call;
+                call.Set("id", e_id);
+                call.Set("method", "Page.navigate");
+                base::DictValue cparams;
+                cparams.Set("url", dest_url);
+                call.Set("params", std::move(cparams));
+                std::string line;
+                base::JSONWriter::Write(base::Value(std::move(call)), &line);
+                self->eval_agent_->DispatchProtocolMessage(
+                    self, base::as_byte_span(line));
+              },
+              this, eid, tid, dest));
+}
